<?php

/**
 * @file
 * Contains associatedps_forms.module.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\user\Entity\Role;
use Drupal\user\Entity\User;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\node\Entity\Node;
use Drupal\paragraphs\Entity\Paragraph;
use Drupal\taxonomy\Entity\Term;
use Drupal\Core\Database\Database;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\InvokeCommand;
use Drupal\associatedps_email_template\Controller\EmailTemplateController;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Component\Utility\NestedArray;
use Drupal\Component\Utility\Tags;

/**
 * Implements hook_preprocess_HOOK() for page title templates.
 */
function associatedps_forms_preprocess_page_title(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'user.login') {
    $variables['title'] = t('User Login');
  }
}

/**
 * Implements hook_preprocess_HOOK() for HTML templates (to change the browser tab title).
 */
function associatedps_forms_preprocess_html(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'user.login') {
    $variables['head_title']['title'] = t('User Login');
  }
}

/**
 * Implements hook_form_alter().
 */
function associatedps_forms_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  /*Condition that checks for Job Edit Form and adds Invoice generation opton in the Job edit form Invoice tab*/
  if ($form_id == 'node_job_edit_form') {
    $path = \Drupal::service('path.current')->getPath();
    $nid = (int) filter_var($path, FILTER_SANITIZE_NUMBER_INT);
    // Email Client button data.
      $email_node = Node::load(abs($nid));
      $client_email = '';
      if ($email_node) {
        if (!empty($email_node->field_client_s_job_email->value)) {
          $client_email = $email_node->field_client_s_job_email->value;
        }
        elseif (!empty($email_node->field_client->target_id)) {
          $client_ref = Node::load($email_node->field_client->target_id);
          if ($client_ref && !empty($client_ref->field_email->value)) {
            $client_email = $client_ref->field_email->value;
          }
        }
      }

      // Single "Generate" dropdown button combining all generate actions.
      // Affidavit/Correspondence routes + CSS class + JS library switch
      // based on the PandaDoc kill-switch in associatedps_affidavit_template.module.
      // FALSE (default) → DocuSign active; TRUE → PandaDoc revived.
      // PandaDoc and DocuSign each have their own URL prefix, their own
      // CSS class, and their own JS file — only one set is rendered + attached
      // per request, so the two integrations never collide.
      $pandadoc_active = function_exists('_associatedps_affidavit_template_pandadoc_active')
        && _associatedps_affidavit_template_pandadoc_active();

      $invoice_url = Url::fromUri('base://xero/generate-invoice/' . $nid)->toString();
      if ($pandadoc_active) {
        $affidavit_url = Url::fromUri('base://pandadoc/generate-affidavit/' . $nid)->toString();
        $correspondence_url = Url::fromUri('base://pandadoc/generate-correspondence/' . $nid)->toString();
        $generate_btn_class = 'pandadoc-generate-btn';
        $generate_library = 'associatedps_affidavit_template/pandadoc-generate';
      }
      else {
        $affidavit_url = Url::fromUri('base://docusign/generate-affidavit/' . $nid)->toString();
        $correspondence_url = Url::fromUri('base://docusign/generate-correspondence/' . $nid)->toString();
        $generate_btn_class = 'docusign-generate-btn';
        $generate_library = 'associatedps_affidavit_template/docusign-generate';
      }

      $generate_dropdown = [
        '#type' => 'inline_template',
        '#template' => '
          <div class="generate-dropdown">
            <a href="#" class="button generate-dropdown__toggle">
              {{ label }}
              <span class="generate-dropdown__arrow">&#9660;</span>
            </a>
            <div class="generate-dropdown__menu">
              <a href="{{ invoice_url }}" class="generate-dropdown__item" target="_blank" rel="opener">{{ "Generate Invoice"|t }}</a>
              <a href="#" class="generate-dropdown__item generate-email-btn" data-job-id="{{ nid }}">{{ "Generate Email"|t }}</a>
              <a href="{{ affidavit_url }}" class="generate-dropdown__item {{ generate_btn_class }}">{{ "Generate Affidavit"|t }}</a>
              <a href="{{ correspondence_url }}" class="generate-dropdown__item {{ generate_btn_class }}">{{ "Generate Correspondence"|t }}</a>
            </div>
          </div>',
        '#context' => [
          'label' => t('Generate'),
          'invoice_url' => $invoice_url,
          'affidavit_url' => $affidavit_url,
          'correspondence_url' => $correspondence_url,
          'generate_btn_class' => $generate_btn_class,
          'nid' => $nid,
        ],
      ];

      $form['action']['generate_dropdown'] = $generate_dropdown;
      $form['action']['generate_dropdown']['#weight'] = '10';

      $form['#attached']['library'][] = 'core/drupal.dialog.ajax';
      $form['#attached']['library'][] = 'associatedps_forms/global';
      $form['#attached']['library'][] = $generate_library;
      $form['#attached']['library'][] = 'associatedps_affidavit_template/generate-email';

      // --- mailto popup DISABLED — automated emails now send silently via
      //     Microsoft 365 Graph (no OS mail client). PRESERVED for recovery:
      //     this read the mailto_data stashed by EmailTemplateController and
      //     passed it to custom.js (associatedpsMailtoTrigger). To restore,
      //     re-enable this block, the stash in the controller, and the JS. ---
      // $tempstore = \Drupal::service('tempstore.private')->get('associatedps_email_template');
      // $mailto_data = $tempstore->get('mailto_data');
      // if ($mailto_data) {
      //   $form['#attached']['drupalSettings']['associatedps_forms']['mailto_trigger'] = $mailto_data;
      //   $tempstore->delete('mailto_data');
      // }
  }

  /* Job Edit/Add form overrides. */

  if (($form_id == 'node_job_edit_form') || ($form_id == 'node_job_form')) {

    // Fix horizontal tabs default state: set #group_exists so the group
    // mechanism properly renders tab members inside the tabs container
    // and enables default tab selection.
    $form['#after_build'][] = '_associatedps_forms_job_form_after_build';
    $form['#attached']['library'][] = 'associatedps_forms/job_form_tabs';
    $form['#attached']['library'][] = 'associatedps_forms/date_autofill';
    $form['#attached']['library'][] = 'associatedps_forms/service_details_modal';
    $form['#attached']['library'][] = 'associatedps_forms/attendance_service_details_modal';

    // Invoice Number is set ONLY by the Xero invoice flow — the Generate Invoice
    // tab injects it into this read-only field via the opener. Staff don't type
    // it; readonly (not disabled) so the injected value still submits on Save.
    if (isset($form['field_invoice_number']['widget'][0]['value'])) {
      $form['field_invoice_number']['widget'][0]['value']['#attributes']['readonly'] = 'readonly';
    }

    // Reconcile the Job Status <-> Attendance Note service-detail field sets.
    // This MUST run as an entity builder (before save), not in node_presave:
    // the address paragraph's existing revision is overwritten in place during
    // the ERR field preSave, which happens before node_presave, so by then the
    // "original" address equals the edited one and an edit looks unchanged.
    $form['#entity_builders'][] = '_associatedps_forms_service_details_entity_builder';

    // Stash the ORIGINAL address signatures now, while the form entity still
    // holds its stored (pre-edit) values — form_alter runs before submitted
    // values are copied into the entity. Reading them later via loadUnchanged()
    // is unreliable: the paragraph entity static cache returns the EDITED
    // paragraph on the submit-phase buildEntity, so an edit looks unchanged.
    $job_entity = $form_state->getFormObject()->getEntity();
    $form_state->set('aps_orig_job_addr_sig', _associatedps_forms_address_signature($job_entity, 'field_para_address'));
    $form_state->set('aps_orig_att_addr_sig', _associatedps_forms_address_signature($job_entity, 'field_attendance_address_served'));

    // "Set to today" checkboxes for admin date fields.
    $date_autofill_fields = [
      'field_admin_affidavit_date' => t('Affidavit Drafted'),
      'field_affidavit_sent_to_agent' => t('Affidavit Sent to Agent'),
      'field_affidavit_sent_to_client' => t('Affidavit Sent to Client'),
      'field_affidavit_received_from_ag' => t('Affidavit Received from Agent'),
      'field_admin_cover_letter_date' => t('Job Logged'),
      'field_admin_email_update_date' => t('Email Update Sent'),
      'field_admin_invoiced_date' => t('Invoice Drafted'),
      'field_admin_send_to_client_date' => t('Invoice Sent to Client'),
      'field_allocation_date' => t('Job Allocated'),
    ];

    foreach ($date_autofill_fields as $field_name => $label) {
      $form[$field_name]['autofill_today'] = [
        '#type' => 'inline_template',
        '#template' => '<div class="date-autofill-wrapper"><label class="date-autofill-label"><input type="checkbox" class="date-autofill-checkbox" data-date-field="{{ field_name }}" /> {{ label }}</label></div>',
        '#context' => [
          'field_name' => $field_name,
          'label' => $label,
        ],
        '#weight' => -10,
      ];
    }

    // Inline layout for "Affidavit Drafted": the field wrapper
    // (.field--name-field-admin-affidavit-date) already contains the
    // autofill checkbox and the date fieldset as siblings, so the CSS
    // in assets/css/date_autofill.css just flexes that wrapper and hides
    // the fieldset legend.

    // "Create New Client" button — shared across add and edit forms.
    $client_nid = ($form_id == 'node_job_edit_form')
      ? (int) filter_var(\Drupal::service('path.current')->getPath(), FILTER_SANITIZE_NUMBER_INT)
      : 0;
    $form['group_job_details']['open_modal'] = [
      '#type' => 'link',
      '#title' => 'Create New Client',
      '#url' => Url::fromUri('base://add-client/' . $client_nid),
      '#attributes' => [
        'class' => [
          'use-ajax',
          'button',
        ],
        'data-dialog-type' => 'modal',
        'data-dialog-options' => '{"width":800}',
      ],
      '#weight' => '7',
    ];

    // "Add New Court" button — shared across add and edit forms.
    $form['group_court_details']['open_modal_court'] = [
      '#type' => 'link',
      '#title' => 'Add New Court',
      '#url' => Url::fromUri('base://add-court/' . $client_nid),
      '#attributes' => [
        'class' => [
          'use-ajax',
          'button',
        ],
        'data-dialog-type' => 'modal',
        'data-dialog-options' => '{"width":800}',
      ],
      '#weight' => '51',
    ];

    // NOTE: the "Create New Document" button is no longer a single button here.
    // It is now rendered INSIDE each document paragraph, next to that
    // paragraph's Document field, so the created document auto-fills that
    // specific paragraph. See associatedps_forms_field_widget_single_element_form_alter().

    // "Add New User" button — placed right after the Allocated To field.
    $form['group_job_status']['open_modal_user'] = [
      '#type' => 'link',
      '#title' => 'Add New User',
      '#url' => Url::fromUri('base://add-user/' . $client_nid),
      '#attributes' => [
        'class' => [
          'use-ajax',
          'button',
        ],
        'data-dialog-type' => 'modal',
        'data-dialog-options' => '{"width":800}',
      ],
      '#weight' => '21',
    ];

    // "Admin Status" sub-heading: rendered as the first child of the
    // Affidavit Drafted field so it rides along with that field's position
    // inside group_job_status. Sits above the checkbox and the date row.
    if (isset($form['field_admin_affidavit_date'])) {
      $form['field_admin_affidavit_date']['admin_status_header'] = [
        '#type' => 'inline_template',
        '#template' => '<h3 class="admin-status-header">{{ label }}</h3>',
        '#context' => [
          'label' => t('Admin Status'),
        ],
        '#weight' => 22,
      ];
    }

    // "Save & Next" button — saves the form and advances to the next tab.
    //
    // It must behave EXACTLY like the real Save button: run ::submitForm/::save
    // (so a brand-new Job is actually created) AND flush inline-entity-form rows
    // such as Job Fees into the entity. Both depend on properties the form
    // builder snapshots onto the *triggering element* DURING form build (see
    // FormBuilder::doBuildForm + FormState::setTriggeringElement, which stores a
    // copy), BEFORE #after_build runs:
    //   - FormSubmitter reads #submit from that snapshot (falling back to the
    //     form-level #submit, which here is only ['::submitForm'] — no ::save),
    //   - the IEF widget's extractFormValues() copies IEF rows onto the entity
    //     only when the snapshot carries #ief_submit_trigger.
    // Therefore these MUST be set here in form_alter, never in #after_build —
    // setting them later silently drops both the node save and the Job Fees.
    //
    // associatedps_forms' form_alter runs BEFORE inline_entity_form's, so the
    // Save button's #submit does not yet contain IEF's flush trigger; add it
    // ourselves (idempotently, in case ordering ever changes) and set the
    // matching #ief_submit_trigger* markers, mirroring ElementSubmit::addCallback().
    $save_next_submit = $form['actions']['submit']['#submit'] ?? [];
    $ief_trigger = ['Drupal\inline_entity_form\ElementSubmit', 'trigger'];
    if (!in_array($ief_trigger, $save_next_submit, TRUE)) {
      array_unshift($save_next_submit, $ief_trigger);
    }
    $form['actions']['save_next'] = [
      '#type' => 'submit',
      '#value' => t('Save & Next'),
      '#submit' => $save_next_submit,
      '#ief_submit_trigger' => TRUE,
      '#ief_submit_trigger_all' => TRUE,
      '#attributes' => ['class' => ['button', 'save-next-btn']],
      '#weight' => 6,
    ];

    /* Prevent agents from editing jobs to which they are not assigned. */
    $roles = Role::loadMultiple();
    $userCurrent = \Drupal::currentUser();
    $user = User::load($userCurrent->id());
    $roles = $user->getRoles();
    if ($userCurrent->id() > 0 && $roles[1] == "agent") {

      $form['title']['#access'] = FALSE;
      $form['field_admin_affidavit_date']['#disabled'] = TRUE;
      $form['field_affidavit_sent_to_agent']['#disabled'] = TRUE;
      $form['field_admin_cover_letter_date']['#disabled'] = TRUE;
      $form['field_admin_email_update_date']['#disabled'] = TRUE;
      $form['field_admin_invoiced_date']['#disabled'] = TRUE;
      $form['field_admin_send_to_client_date']['#disabled'] = TRUE;
      $form['field_admin_status']['#disabled'] = TRUE;
      $form['field_affidavits']['#disabled'] = TRUE;
      $form['field_agreed_discount']['#disabled'] = TRUE;
      $form['field_allocated_to']['#disabled'] = TRUE;
      $form['field_allocation_date']['#disabled'] = TRUE;
      $form['field_case_no']['#disabled'] = TRUE;
      $form['field_client']['#disabled'] = TRUE;
      $form['field_client_ref']['#disabled'] = TRUE;
      $form['field_client_s_job_email']['#disabled'] = TRUE;
      $form['field_court']['#disabled'] = TRUE;
      $form['field_cover_letters']['#disabled'] = TRUE;
      $form['field_deadline']['#disabled'] = TRUE;
      $form['field_division']['#disabled'] = TRUE;
      $form['field_documents']['#disabled'] = TRUE;
      $form['field_hearing_date']['#disabled'] = TRUE;
      $form['field_instruction_received']['#disabled'] = TRUE;
      $form['field_job_fees']['#disabled'] = TRUE;
      $form['field_job_types']['#disabled'] = TRUE;
      $form['field_last_mail_time']['#disabled'] = TRUE;
      $form['field_list']['#disabled'] = TRUE;
      $form['field_other_parties']['#disabled'] = TRUE;
      $form['field_parties']['#disabled'] = TRUE;
      $form['field_party_2']['#disabled'] = TRUE;
      $form['field_party_to_serve_phone']['#disabled'] = TRUE;
      $form['field_registry']['#disabled'] = TRUE;
      $form['field_service_address']['#disabled'] = TRUE;
      $form['field_served_party']['#disabled'] = TRUE;
      $form['field_served_notes']['#disabled'] = TRUE;

      $node = $form_state->getFormObject()->getEntity();
      $allocated_to = $node->get('field_allocated_to')->target_id;
      if ($allocated_to != $userCurrent->id()) {
        die();
      }
    }

    /* Rename some button labels. */
    $form["field_party_to_serve_phone"]["widget"]["add_more"]["#value"] = 'Add Additional Phone Number';
    $form["field_attendance_notes"]["widget"]["add_more"]["add_more_button_attendance_note"]["#value"] = 'Add Additional Attendance Note';
    $form["field_affidavits"]["widget"]["add_more"]["add_more_button_affidavit"]["#value"] = 'Add Additional Affidavit';
    $form["field_cover_letters"]["widget"]["add_more"]["add_more_button_cover_letter"]["#value"] = 'Add Additional Cover Letter';
    $form["field_service_address"]["widget"]["#title"] = t('Address');
    if (isset($form["field_service_address"]["widget"]["actions"]["ief_add"])) {
      $form["field_service_address"]["widget"]["actions"]["ief_add"]["#value"] = t('Add Address');
    }
    // Replace internal DB ID with full address in the IEF table rows.
    if (isset($form["field_service_address"]["widget"]["entities"])) {
      foreach ($form["field_service_address"]["widget"]["entities"] as $key => &$entity_item) {
        if (is_numeric($key) && isset($entity_item['#entity'])) {
          $addr_entity = $entity_item['#entity'];
          if ($addr_entity->hasField('field_service_address')) {
            $addr_values = $addr_entity->get('field_service_address')->getValue();
            if (!empty($addr_values)) {
              $addr = reset($addr_values);
              $parts = array_filter([
                $addr['address_line1'] ?? '',
                $addr['locality'] ?? '',
                $addr['administrative_area'] ?? '',
                $addr['postal_code'] ?? '',
              ]);
              if (!empty($parts)) {
                $entity_item['#label'] = implode(', ', $parts);
              }
            }
          }
        }
      }
      unset($entity_item);
    }
    $form["field_documents"]["widget"]["add_more"]["add_more_button_document"]["#value"] = 'Add Additional Document To Job';
    $form["field_parties"]["widget"]["add_more"]["add_more_button_party"]["#value"] = 'Add Additional Party (Side 1)';
    $form["field_party_2"]["widget"]["add_more"]["add_more_button_party_side_two_"]["#value"] = 'Add Additional Party (Side 2)';
    $form["field_other_parties"]["widget"]["add_more"]["add_more_button_party_other"]["#value"] = 'Add Additional Party (Other)';
    $form["field_job_fees"]["widget"]["add_more"]["add_more_button_job_fees"]["#value"] = 'Add Additional Service';
    if (isset($form["field_job_fees"]["widget"]["actions"]["ief_add"])) {
      $form["field_job_fees"]["widget"]["actions"]["ief_add"]["#value"] = t('Additional Fee');
    }
    $form["field_client_actions_ief_add"]["#value"] = 'Save';
    /* Autocomplete Client */
    $form["field_client"]["widget"][0]["value"]["#ajax"]["event"] = 'autocomplete_select';

    /* client's job email base on client's generic email. */
    $form["field_client"]["widget"]["#ajax"] = [
      'event' => 'change',
      'callback' => 'associatedps_forms_change_client_email',
    ];

    $form['field_client_s_job_email']['widget'][0]['value']['#attributes']['id'] = 'change-client-email';
    $form['field_agreed_discount']['widget'][0]['value']['#attributes']['id'] = 'change-client-discount';

    /* Sync Side Two party names into the Name to Serve dropdown. */
    $form['#attached']['library'][] = 'associatedps_forms/party_to_serve_sync';

    /* Sync Party to Serve addresses into Attendance Note paragraphs. */
    $form['#attached']['library'][] = 'associatedps_forms/attendance_address_sync';

    /* Preload service term fees for JS-based standard fee population.
     * The #ajax Form API approach does not work reliably for autocomplete
     * fields inside IEF paragraph subforms (generated via AJAX), so we
     * pass the fee map to JS and let a Drupal behavior handle it. */
    $form['#attached']['library'][] = 'associatedps_forms/service_fee_sync';
    $service_terms = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadByProperties(['vid' => 'services']);
    $service_fees = [];
    foreach ($service_terms as $term) {
      $service_fees[$term->id()] = $term->field_standard_fee->value ?? '';
    }
    $form['#attached']['drupalSettings']['associatedps_forms']['service_fees'] = $service_fees;

    // Pass client discount to drupalSettings for fee total calculation.
    $client_discount = 0;
    $node = $form_state->getFormObject()->getEntity();
    if ($node && !$node->isNew() && !$node->get('field_client')->isEmpty()) {
      $client_node = Node::load($node->get('field_client')->target_id);
      if ($client_node && $client_node->hasField('field_agreed_discount')) {
        $client_discount = (float) ($client_node->get('field_agreed_discount')->value ?? 0);
      }
    }
    $form['#attached']['drupalSettings']['associatedps_forms']['client_discount'] = $client_discount;

    /* Client summary box — client NAMES are not unique (uniqueness is the
     * email/phone), so show the selected client's address + contact details
     * next to the Client field to tell duplicates apart. Shared by the add and
     * edit Job forms: rendered here for an already-selected client (edit, or one
     * just created via the modal on /node/add/job) and refreshed on change by
     * associatedps_forms_change_client_email(). The #prefix opens a flex row and
     * the #suffix holds the summary div and closes the row. */
    $summary_client_id = NULL;
    if ($node && !$node->isNew() && !$node->get('field_client')->isEmpty()) {
      $summary_client_id = $node->get('field_client')->target_id;
    }
    elseif (!empty($_COOKIE['Drupal_visitor_node_id']) && !empty($_COOKIE['Drupal_visitor_client_submit'])) {
      // Client just created via the modal on the Add Job form.
      $summary_client_id = (int) $_COOKIE['Drupal_visitor_node_id'];
    }
    $summary_client = $summary_client_id ? Node::load($summary_client_id) : NULL;
    $form['field_client']['#prefix'] = '<div class="client-field-row">';
    $form['field_client']['#suffix'] = '<div id="client-summary" class="client-summary-box">'
      . _associatedps_forms_client_summary_html($summary_client) . '</div></div>';

    /* Allow dynamically-added values in select_or_other fields. */
    $form['field_served_party']['widget']['#after_build'][] = '_associatedps_forms_after_build_select_or_other';
    $form['field_business_name']['widget']['#after_build'][] = '_associatedps_forms_after_build_select_or_other';

    /* field_person_delivered_to is now a standard select list. */
    $form['field_person_delivered_to']['widget']['#after_build'][] = '_associatedps_forms_after_build_standard_select';

    /* Ensure dynamically-set values pass entity validation. */
    array_unshift($form['#validate'], '_associatedps_forms_validate_dynamic_select_options');

    /* Fix dynamically-added address values in IEF paragraph subforms.
     * hook_field_widget_single_element_form_alter does NOT fire for IEF
     * attendance_note paragraphs during AJAX, so we use a form-level
     * #after_build that runs after the entire form tree (including all
     * IEF subforms) is built but before validation. */
    $form['#after_build'][] = '_associatedps_forms_after_build_fix_ief_address_selects';

    /* User id list for the JS-based Employee field sync (below). */

    $query = \Drupal::entityQuery('user')->accessCheck(FALSE);
    $uids = $query->execute();
    // field_served_by previously had its options overridden here with a custom
    // user list (_associatedps_forms_get_users), which gave blank labels to
    // users without an address name and so appeared to be "missing" users. It
    // now uses the field's default entity-reference handler — the same source as
    // the Attendance tab's field_attendance_served_by — so both show the same,
    // complete user list.

    /* Preload user details for JS-based Employee field sync.
     * When Allocated To changes after a paragraph is already generated,
     * JS uses this map to populate empty Employee autocomplete fields. */
    $form['#attached']['library'][] = 'associatedps_forms/employee_sync';
    $user_details = [];
    foreach ($uids as $uid) {
      $user_obj = User::load($uid);
      if ($user_obj) {
        $addr = $user_obj->field_address->getValue();
        $addr = reset($addr);
        if ($addr && isset($addr['given_name']) && isset($addr['family_name'])) {
          $user_details[$uid] = [
            'label' => $user_obj->label(),
            'given_name' => $addr['given_name'],
            'family_name' => $addr['family_name'],
          ];
        }
      }
    }
    $form['#attached']['drupalSettings']['associatedps_forms']['user_details'] = $user_details;

  }

  if ($form_id == 'node_job_edit_form') {

    $path = \Drupal::service('path.current')->getPath();
    $nid = (int) filter_var($path, FILTER_SANITIZE_NUMBER_INT);
    // Wrap Edit Client and Email Client buttons in a container so they
    // appear side by side, above Instruction Received.
    // Generate dropdown above the tab section.
    $form['generate_dropdown_top'] = $generate_dropdown;
    $form['generate_dropdown_top']['#weight'] = '-100';




    $form['#attached']['library'][] = 'core/drupal.dialog.ajax';
    $form['#attached']['library'][] = 'associatedps_forms/global';

    /* Set Client after save last step. */
    $client_cid = $form['field_client_cid']['widget'][0]['value']['#default_value'] ?? NULL;
    if (!empty($client_cid) && isset($form['field_client']['widget']['#default_value']) && ($form['field_client']['widget']['#default_value'] === [])) {
      $form['field_client']['widget']['#default_value'][] = $client_cid;
    }

    /* After node save functionality */
    $nid = abs($nid);
    if (!empty($nid)) {
      $node = Node::load($nid);

      /* Pass saved service addresses to JS for attendance address sync.
       * When saved IEF paragraphs are in table/collapsed mode their form
       * fields are not in the DOM, so JS cannot read them directly. */
      $saved_service_addresses = [];
      if (!empty($node->field_service_address->getValue())) {
        foreach ($node->field_service_address as $addr_ref) {
          $addr_para = Paragraph::load($addr_ref->target_id);
          if (!$addr_para) {
            continue;
          }
          $address = $addr_para->field_service_address->first();
          if (!$address) {
            continue;
          }
          $vals = $address->getValue();
          $has_value = !empty($vals['address_line1']) || !empty($vals['locality'])
            || !empty($vals['administrative_area']) || !empty($vals['postal_code']);
          if ($has_value) {
            $saved_service_addresses[] = [
              'address_line1' => $vals['address_line1'] ?? '',
              'address_line3' => $vals['address_line3'] ?? '',
              'locality' => $vals['locality'] ?? '',
              'administrative_area' => $vals['administrative_area'] ?? '',
              'postal_code' => $vals['postal_code'] ?? '',
              'organization' => $vals['organization'] ?? '',
              'isPrimary' => (bool) $addr_para->field_primary_address->value,
            ];
          }
        }
      }
      $form['#attached']['drupalSettings']['associatedps_forms']['service_addresses'] = $saved_service_addresses;

      /* Start Name To Serve and Person Delivered options and default value */
      $party_list = [];
      $person_list = [];
      $business_list = [];
      $default = [];
      $default_value = '';
      if (!empty($node->field_parties->getValue())) {
        $party_one = $node->field_parties->getValue();
        foreach ($party_one as $value) {
          $party_one_para = Paragraph::load($value['target_id']);
          $first_name = $party_one_para->field_name->value;
          $last_name = $party_one_para->field_last_name->value;
          $full_name = $first_name . " " . $last_name;
          $party_one_para->set('field_full_name', $full_name);
          $party_one_para->save();
          $party_list[$full_name] = $full_name;
          $person_list[$full_name] = $full_name;
          $business_list[$full_name] = $full_name;
        }
      }
      if (!empty($node->field_party_2->getValue())) {
        $party_two = $node->field_party_2->getValue();
        foreach ($party_two as $value) {
          $party_two_para = Paragraph::load($value['target_id']);
          $first_name = $party_two_para->field_name->value;
          $last_name = $party_two_para->field_last_name->value;
          $full_name = $first_name . " " . $last_name;
          $party_two_para->set('field_full_name', $full_name);
          $party_two_para->save();
          $party_list[$full_name] = $full_name;
          $person_list[$full_name] = $full_name;
          $business_list[$full_name] = $full_name;
          $default[] = $full_name;
          $default_value = $default[0];
        }
      }

      // Other Parties (field_other_parties / party_other paragraph) are also
      // selectable in "Person Delivered To" AND "Name to Serve" — their name is
      // stored in field_name (single, no last name). Added to both $person_list
      // and $party_list so it flows to those fields (and the attendance copy,
      // built from $person_list below).
      if (!empty($node->field_other_parties->getValue())) {
        foreach ($node->field_other_parties->getValue() as $value) {
          $op_para = Paragraph::load($value['target_id']);
          if (!$op_para) {
            continue;
          }
          $op_name = trim((string) $op_para->field_name->value);
          if ($op_name !== '') {
            $person_list[$op_name] = $op_name;
            $party_list[$op_name] = $op_name;
          }
        }
      }

      if (empty($form["field_served_party"]["widget"]["#default_value"])) {
        $form["field_served_party"]["widget"]["#default_value"] = $default_value;
      }
      if (!empty($node->field_name_to_other->value)) {
        $party_other = $node->field_name_to_other->value;
        $party_list[$party_other] = $party_other;
        $form["field_served_party"]["widget"]["#options"] = $party_list;
      }
      if (!empty($node->field_person_delivered_to_other->value)) {
        $person_other = $node->field_person_delivered_to_other->value;
        $person_list[$person_other] = $person_other;
        $form["field_person_delivered_to"]["widget"]["#options"] = $person_list;
      }
      if (!empty($node->field_business_other->value)) {
        $business_other = $node->field_business_other->value;
        $business_list[$business_other] = $business_other;
        $form["field_business_name"]["widget"]["#options"] = $business_list;
      }
      // Add the currently saved field_served_party value back into options
      // so the Select or Other widget doesn't strip it as an unknown value.
      $saved_served_party = $node->field_served_party->value ?? '';
      if (!empty($saved_served_party) && !isset($party_list[$saved_served_party])) {
        $party_list[$saved_served_party] = $saved_served_party;
      }
      // Add the currently saved field_person_delivered_to value back into options.
      $saved_person_delivered = $node->field_person_delivered_to->value ?? '';
      if (!empty($saved_person_delivered) && !isset($person_list[$saved_person_delivered])) {
        $person_list[$saved_person_delivered] = $saved_person_delivered;
      }
      // Add the currently saved field_business_name value back into options.
      $saved_business_name = $node->field_business_name->value ?? '';
      if (!empty($saved_business_name) && !isset($business_list[$saved_business_name])) {
        $business_list[$saved_business_name] = $saved_business_name;
      }
      // Custom ("Other") Person Delivered To values are scoped to THIS job only:
      // the node's own saved value is re-added to $person_list above. Global
      // State accumulation was removed because it leaked OTHER jobs' custom
      // names into this dropdown.

      $form["field_served_party"]["widget"]["#options"] = $party_list;
      // The select_or_other widget builds its inner select from
      // (#original_options ?? #options) — see ElementBase::addSelectField(). When
      // the widget's "add_other_value_to_allowed_values" setting is OFF (as on
      // staging), ListWidget::formElement() sets #original_options from the
      // field's GLOBAL allowed_values (every job's accumulated party names), so
      // our #options override above is IGNORED and the dropdown lists parties
      // from ALL jobs. Override #original_options too so the inner select is
      // scoped to THIS job regardless of that per-environment widget setting.
      $form["field_served_party"]["widget"]["#original_options"] = $party_list;
      // '_other' lets the user enter a one-off name (handled client-side by
      // party_to_serve_sync.js, since the select_or_other widget regresses here).
      $form["field_person_delivered_to"]["widget"]["#options"] = ['_none' => '- None -'] + $person_list + ['_other' => '- Other -'];
      $form["field_business_name"]["widget"]["#options"] = $business_list;

      // Mirror the Person Delivered To options onto the Attendance Note copy
      // (field_atten_person_delivered_to) so the SAME party names are selectable
      // there. The two fields are reconciled server-side on Save
      // (_associatedps_forms_sync_service_details); without matching options the
      // attendance widget cannot render the synced value and the tabs appear
      // out of sync. Build from the same $person_list, plus the attendance
      // field's own currently-saved value so it isn't stripped as unknown.
      if (isset($form['field_atten_person_delivered_to']['widget'])) {
        $atten_person_list = $person_list;
        $saved_atten_person = $node->field_atten_person_delivered_to->value ?? '';
        if (!empty($saved_atten_person) && !isset($atten_person_list[$saved_atten_person])) {
          $atten_person_list[$saved_atten_person] = $saved_atten_person;
        }
        $form['field_atten_person_delivered_to']['widget']['#options'] = ['_none' => '- None -'] + $atten_person_list + ['_other' => '- Other -'];
        $form['field_atten_person_delivered_to']['widget']['#after_build'][] = '_associatedps_forms_after_build_standard_select';
      }
      /* Finish Name To Serve and Person Delivered options and default value */

      /* Deadline Date */

      if (!empty($node->field_hearing_date->value) && !empty($node->field_documents->getValue())) {

        $deadline_date = '';
        $documents = $node->field_documents->getValue();
        foreach ($documents as $value) {
          $document = Paragraph::load($value['target_id']);
          $primary_doc = $document->field_primary_document->value;
          if ($primary_doc === '1') {
            if (!empty($document->field_override_notice_period->value)) {
              $notice_period = $document->field_override_notice_period->value;
            }
            if (empty($document->field_override_notice_period->value) && !empty($document->field_notice_period->value)) {
              $notice_period = $document->field_notice_period->value;
            }
            if (!empty($notice_period)) {
              $hearing_date = date_create($node->field_hearing_date->value);
              $deadline_date = date_sub($hearing_date, date_interval_create_from_date_string($notice_period . " days"));
              $deadline_date = date_format($deadline_date, "Y-m-d");
            }
          }
        }
        if (!empty($deadline_date)) {
          if ($form['field_deadline']['widget'][0]['value']['#default_value'] === NULL) {
            $form['field_deadline']['widget'][0]['value']['#default_value'] = DrupalDateTime::createFromTimestamp(strtotime($deadline_date));
          }
        }
      }
      /* Finish Deadline Date */
    }

  }

  /* Client form alterations. */
  if ($form_id == 'node_client_form') {
    $connection = \Drupal::database();
    $query = $connection->query("SELECT count(nid) AS nodes FROM {node} WHERE node.type = 'client';");
    $result = $query->fetchAll();
    $count = (int) $result[0]->nodes + 1;
    /* Populates the client ID field when creating a new client. */
    $form["field_client_id"]["widget"][0]["value"]["#default_value"] = '54323' . $count;
    $form['field_client_id']['#disabled'] = TRUE;
  }

  if ($form_id == 'node_client_edit_form') {
    $form['field_client_id']['#disabled'] = TRUE;
  }

  /* Job form alterations. */
  if ($form_id == 'node_job_form') {

    $connection = \Drupal::database();
    $query = $connection->query("SELECT count(nid) AS nodes FROM {node} WHERE node.type = 'job';");
    $result = $query->fetchAll();
    $count = (int) $result[0]->nodes + 1;
    /* Populates the job ID field when creating a new job. */
    $form["title"]["widget"][0]["value"]["#default_value"] = '09327' . $count;


    $form['#attached']['library'][] = 'core/drupal.dialog.ajax';
    $form['#attached']['library'][] = 'associatedps_forms/global';

    // Name to Serve (field_served_party, a select_or_other field) on the ADD
    // form: a new job has no parties yet, so the per-job scoping in the
    // edit-only block (if node_job_edit_form) never runs here, and the widget
    // falls back to the field's GLOBAL allowed_values — every job's accumulated
    // party names. Scope it to empty so it shows only "- None -" / "Other"; JS
    // (party_to_serve_sync.js) fills it live as parties are added. The inner
    // select reads (#original_options ?? #options), so set BOTH (this is what
    // made staging differ: with add_other_value_to_allowed_values OFF the widget
    // sets #original_options from allowed_values and ignores #options alone).
    if (isset($form['field_served_party']['widget'])) {
      $form['field_served_party']['widget']['#options'] = [];
      $form['field_served_party']['widget']['#original_options'] = [];
    }

    // Person Delivered To (Job Status + its Attendance Note copy) on the ADD
    // form: same problem as Name to Serve above. These are options_select
    // fields whose per-job #options is set only in the edit-only block, so on a
    // new job they fall back to the field's GLOBAL allowed_values (every job's
    // accumulated party names). Scope to "- None -" / "- Other -"; JS fills the
    // party names live as they are added.
    foreach (['field_person_delivered_to', 'field_atten_person_delivered_to'] as $pdf) {
      if (isset($form[$pdf]['widget'])) {
        $form[$pdf]['widget']['#options'] = ['_none' => '- None -', '_other' => '- Other -'];
      }
    }

    // Pre-populate client field if a client was just created via modal.
    $cookie_client_nid = isset($_COOKIE['Drupal_visitor_node_id']) ? $_COOKIE['Drupal_visitor_node_id'] : '';
    $cookie_client_submit = isset($_COOKIE['Drupal_visitor_client_submit']) ? $_COOKIE['Drupal_visitor_client_submit'] : 0;
    if (!empty($cookie_client_nid) && $cookie_client_submit != 0) {
      if (isset($form['field_client']['widget']['#default_value']) && ($form['field_client']['widget']['#default_value'] === [])) {
        $form['field_client']['widget']['#default_value'][] = $cookie_client_nid;
      }
      $client_node = Node::load($cookie_client_nid);
      if ($client_node) {
        $client_email = !empty($client_node->get('field_email')->getValue()) ? $client_node->get('field_email')->getValue()[0]['value'] : '';
        $client_discount = !empty($client_node->get('field_agreed_discount')->getValue()) ? $client_node->get('field_agreed_discount')->getValue()[0]['value'] : '';
        $form['field_client_s_job_email']['widget'][0]['value']['#default_value'] = $client_email;
        $form['field_agreed_discount']['widget'][0]['value']['#default_value'] = $client_discount;
      }
      // Reset cookies immediately so they don't leak into other forms
      // (e.g. editing a different job or revisiting /node/add/job later).
      user_cookie_save([
        'client_submit' => 0,
        'client_name' => '',
        'client_id' => '',
        'telephone' => '',
        'generic_email' => '',
        'discount' => '',
        'notes' => '',
        'sa_address_line1' => '',
        'sa_address_line2' => '',
        'sa_locality' => '',
        'sa_postal_code' => '',
        'sa_administrative_area' => '',
        'node_id' => '',
      ]);
    }

    // Pre-populate court field if a court was just created via modal.
    $cookie_court_tid = isset($_COOKIE['Drupal_visitor_court_term_id']) ? $_COOKIE['Drupal_visitor_court_term_id'] : '';
    $cookie_court_submit = isset($_COOKIE['Drupal_visitor_court_submit']) ? $_COOKIE['Drupal_visitor_court_submit'] : 0;
    if (!empty($cookie_court_tid) && $cookie_court_submit != 0) {
      $form['field_court']['widget']['#default_value'][] = $cookie_court_tid;
      // Reset cookies immediately so they don't leak into other forms.
      user_cookie_save([
        'court_submit' => 0,
        'court_term_id' => '',
      ]);
    }

    // Pre-populate allocated_to field if a user was just created via modal.
    $cookie_new_user_uid = isset($_COOKIE['Drupal_visitor_new_user_uid']) ? $_COOKIE['Drupal_visitor_new_user_uid'] : '';
    $cookie_new_user_submit = isset($_COOKIE['Drupal_visitor_new_user_submit']) ? $_COOKIE['Drupal_visitor_new_user_submit'] : 0;
    if (!empty($cookie_new_user_uid) && $cookie_new_user_submit != 0) {
      $new_user = User::load($cookie_new_user_uid);
      if ($new_user) {
        if (isset($form['field_allocated_to']['widget']['#default_value'])) {
          $form['field_allocated_to']['widget']['#default_value'][] = $cookie_new_user_uid;
        }
      }
      // Reset cookies immediately so they don't leak into other forms.
      user_cookie_save([
        'new_user_submit' => 0,
        'new_user_uid' => '',
      ]);
    }

    // Reset document cookies on page load so they don't leak if user
    // navigates away without saving. The presave hook will also clear
    // them, but this covers the case where the user never saves.
    $cookie_doc_submit = isset($_COOKIE['Drupal_visitor_document_submit']) ? $_COOKIE['Drupal_visitor_document_submit'] : 0;
    if ($cookie_doc_submit != 0) {
      user_cookie_save([
        'document_submit' => 0,
        'node_doc_id' => '',
        'document_title' => '',
        'notice_period' => '',
        'court_name' => '',
        'affidavit_template' => '',
      ]);
      setcookie('create_doc_for_job', '', time() - 3600, '/');
    }
  }

  //var_dump("node job form initialized<br/>");

  /* Client Edit/Add form: email events and template configuration. */

  if (($form_id == 'node_client_form') || ($form_id == 'node_client_edit_form')) {

    // Load form.css (global library) so the client form picks up the
    // "Attendance Update - Frequency" inline-layout rules; it was never
    // attached on this form before.
    $form['#attached']['library'][] = 'associatedps_forms/global';

    // The Mail Event + Email Template paired-dropdown UI has been removed.
    // field_email_template is still read by EmailTemplateController when an
    // update email is sent, so keep its raw widget off the client form.
    $form['field_email_template']['#access'] = FALSE;
  }

  /* Hide preview button from Email Preview and Preview node. */
  if (($form_id == 'node_email_preview_form') || ($form_id == 'node_email_preview_edit_form') || ($form_id == 'node_preview_form') || ($form_id == 'node_preview_edit_form')) {

    $form['actions']['preview']['#access'] = FALSE;
  }

  /* Court Name Taxonomy Edit/Add form name field overrides. */

  if ($form_id == 'taxonomy_term_court_name_form') {

    $route = \Drupal::routeMatch()->getCurrentRouteMatch()->getRouteObject();
    $get_title = $route->getDefault('_title');
    if ($get_title == 'Add term') {
      $route->setDefault('_title', 'Add Court');
    }

    $form["name"]["widget"][0]['value']['#title'] = t('Court Name');
  }

  /* Services Taxonomy Edit/Add form name field overrides. */

  if ($form_id == 'taxonomy_term_services_form') {
    $form["name"]["widget"][0]['value']['#title'] = t('Type of Service');
  }

  /* Alter LogIn form title. */

  if ($form_id == 'user_login_form') {
    $route = \Drupal::routeMatch()->getCurrentRouteMatch()->getRouteObject();
    $route->setDefault('_title', 'Admin Login');
  }

  /* Online Instruction add/edit form */
  if (($form_id == 'node_online_instruction_form')) {
    $userCurrent = \Drupal::currentUser();
    $user = User::load($userCurrent->id());
    $user_name = $user->name->value;
    $form['title']['widget'][0]['value']['#default_value'] = 'Online Instruction by ' . $user_name;
    $form['title']['#access'] = FALSE;
    $form['actions']['submit']['#value'] = 'Save Online Instruction';
  }
  if (($form_id == 'node_online_instruction_edit_form') || ($form_id == 'node_online_instruction_form')) {
    $form['title']['#access'] = FALSE;
    $form['actions']['submit']['#value'] = 'Save Online Instruction';
  }

  /* Alter View form filter. */
  if (($form['#id'] == 'views-exposed-form-content-jobs--page-1') || ($form['#id'] == 'views-exposed-form-job-page-job-list') || ($form['#id'] == 'views-exposed-form-job-page-per-agent-job-page-per-agent') || ($form['#id'] == 'views-exposed-form-job-page-per-user-job-page-per-user')) {
    /* Allocated To filter */
    $query = \Drupal::entityQuery('user')->accessCheck(FALSE);
    $uids = $query->execute();
    $users = ['' => '- Any -'];
    foreach ($uids as $uid) {
      $user = User::load($uid);
      if (isset($user->field_address) && !empty($user->field_address->getValue())) {
        $address = $user->field_address->getValue();
        $address = reset($address);
        $full_name = $address['given_name'] . ' ' . $address['family_name'];
        if ($full_name !== " ") {
          $users[$full_name] = $full_name;
        }
      }
    }
    if (isset($form['field_allocated_to'])) {
      $form['field_allocated_to'] = [
        '#type' => 'select',
        '#options' => $users,
        '#size' => 1,
      ];
    }

    /* Client Name field filter. */
    $client_nids = \Drupal::entityQuery('node')->condition('type', 'client')->accessCheck(FALSE)->execute();
    $client_nodes = Node::loadMultiple($client_nids);
    $client_options = ['' => '- Any -'];
    foreach ($client_nodes as $node) {
      $title = $node->get('title')->getString();
      if (!empty($title)) {
        $client_options[$title] = $title;
      }
    }
    if (isset($form['field_client_name'])) {
      $form['field_client_name'] = [
        '#type' => 'select',
        '#options' => $client_options,
        '#size' => 1,
      ];
    }

    /* Party to be served field filter. */
    $job_nids = \Drupal::entityQuery('node')->condition('type', 'job')->accessCheck(FALSE)->execute();
    $job_nodes = Node::loadMultiple($job_nids);
    $job_options = ['' => '- Any -'];
    $postal_options = ['' => '- Any -'];
    foreach ($job_nodes as $node) {
      $party_to_serve = $node->get('field_name_to_server_value')->getString();
      if (!empty($party_to_serve) && $party_to_serve != '- None -') {
        $job_options[$party_to_serve] = $party_to_serve;
      }

      /* Postal code field filter. */
      $address = $node->get('field_service_address')->getValue();
      if (!empty($address)) {
        foreach ($address as $add) {
          $add_para = Paragraph::load($add['target_id']);
          $add_para = $add_para->get('field_service_address')->getValue();
          $add_para = reset($add_para);
          $postal_code = $add_para['postal_code'];
          if (!empty($postal_code)) {
            $postal_options[$postal_code] = $postal_code;
          }
        }
      }
    }
    if (isset($form['field_name_to_server_value'])) {
      $form['field_name_to_server_value'] = [
        '#type' => 'select',
        '#options' => $job_options,
        '#size' => 1,
      ];
    }

    if (isset($form['field_primary_postal_code_value'])) {
      $form['field_primary_postal_code_value'] = [
        '#type' => 'select',
        '#options' => $postal_options,
        '#size' => 1,
      ];
    }

    /* Service Date filter - restyle only, keep original BEF processing intact. */
    if (isset($form['field_served_date_value_wrapper'])) {
      $form['field_served_date_value_wrapper']['#attributes']['class'][] = 'service-date-filter-wrapper';
      $form['field_served_date_value_wrapper']['field_served_date_value']['min']['#title'] = t('Service From');
      $form['field_served_date_value_wrapper']['field_served_date_value']['max']['#title'] = t('Service To');
    }
  }

}

/**
 * Ajax callback associatedps_forms_change_client_email().
 */
function associatedps_forms_change_client_email($form, &$form_state) {
  $client_id = $form_state->getValue('field_client');
  $client_email = $client_dis = '';
  $client = NULL;

  if (!empty($client_id)) {
    $client_id = reset($client_id);
    $client = Node::load($client_id['target_id']);
    $client_email = $client->field_email->value;
    $client_dis = $client->field_agreed_discount->value;
  }
  $response = new AjaxResponse();
  $response->addCommand(new InvokeCommand("#change-client-email", 'val', [$client_email]));
  $response->addCommand(new InvokeCommand("#change-client-discount", 'val', [$client_dis]));
  // Refresh the client summary box (address / email / phone) next to the field.
  $response->addCommand(new \Drupal\Core\Ajax\HtmlCommand('#client-summary', _associatedps_forms_client_summary_html($client)));
  // Update drupalSettings so fee calculation JS picks up the new discount.
  $response->addCommand(new \Drupal\Core\Ajax\SettingsCommand(['associatedps_forms' => ['client_discount' => (float) $client_dis]], TRUE));
  return $response;
}

/**
 * Builds the inner HTML for the Job form's Client summary box.
 *
 * Client names are not unique across the app; their address/email/phone are the
 * distinguishing details. This renders a brief summary shown next to the Client
 * field. Returns '' when there is nothing to show (cleared selection / no data).
 */
function _associatedps_forms_client_summary_html($client) {
  if (!$client) {
    return '';
  }

  $address = '';
  if ($client->hasField('field_client_address') && !$client->get('field_client_address')->isEmpty()) {
    $a = $client->get('field_client_address')->getValue()[0];
    $line = array_filter([
      $a['address_line1'] ?? '',
      $a['address_line2'] ?? '',
      $a['locality'] ?? '',
      $a['administrative_area'] ?? '',
      $a['postal_code'] ?? '',
    ]);
    $address = implode(', ', $line);
  }
  $email = $client->hasField('field_email') ? trim((string) $client->get('field_email')->value) : '';
  $phone = $client->hasField('field_telephone') ? trim((string) $client->get('field_telephone')->value) : '';

  if ($address === '' && $email === '' && $phone === '') {
    return '';
  }

  $rows = [];
  if ($address !== '') {
    $rows[] = 'Address: ' . Html::escape($address);
  }
  $contact = [];
  if ($email !== '') {
    $contact[] = 'Email: ' . Html::escape($email);
  }
  if ($phone !== '') {
    $contact[] = 'Phone: ' . Html::escape($phone);
  }
  if ($contact) {
    $rows[] = implode(' &nbsp;|&nbsp; ', $contact);
  }

  return implode('<br>', $rows);
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
function associatedps_forms_field_widget_single_element_form_alter(&$element, FormStateInterface $form_state, $context) {
  $field_definition = $context['items']->getFieldDefinition();
  if ($field_definition->getType() == 'entity_reference_revisions') {
    $path = \Drupal::service('path.current')->getPath();
    $nid = (int) filter_var($path, FILTER_SANITIZE_NUMBER_INT);

    if (isset($element['#paragraph_type']) && $element['#paragraph_type'] == 'document') {

      // Hide "Add another item" inside field_document so users add
      // documents only via the paragraph-level "Add Additional Document To Job".
      if (isset($element['subform']['field_document']['widget']['add_more'])) {
        $element['subform']['field_document']['widget']['add_more']['#access'] = FALSE;
      }

      // For add mode, pre-populate field_document from cookie on the first
      // empty paragraph. Cookies are cleared in form_alter (Fix 4b) so
      // the presave cookie-based paragraph creation won't duplicate this.
      if ($nid == 0 && $context['delta'] == 0) {
        $cookie_doc_nid = isset($_COOKIE['Drupal_visitor_node_doc_id']) ? $_COOKIE['Drupal_visitor_node_doc_id'] : '';
        $cookie_doc_submit = isset($_COOKIE['Drupal_visitor_document_submit']) ? $_COOKIE['Drupal_visitor_document_submit'] : 0;
        if (!empty($cookie_doc_nid) && $cookie_doc_submit != 0) {
          $doc_node = Node::load($cookie_doc_nid);
          if ($doc_node && isset($element['subform']['field_document'])) {
            $element['subform']['field_document']['widget'][0]['target_id']['#default_value'] = $doc_node;
          }
        }
      }

      /* Notice Period based on selected document before save node. */

      $ajax_id = 'edit-field-documents';
      foreach ($element['subform']['field_doc_notice_period']['widget']['#parents'] as $value) {
        $ajax_id .= is_int($value) ? "-" . $value : "";
      }
      $ajax_id .= "-subform-field-doc-notice-period-0-value";

      $element['subform']['field_doc_notice_period']['widget'][0]['value']['#attributes']['id'] = $ajax_id;

      $element['subform']['field_document']['widget']['#ajax'] = [
        'event' => 'change',
        'wrapper' => $ajax_id,
        'callback' => 'associatedps_forms_change_notice_period',
      ];

      // Per-paragraph "Create New Document" button, next to the Document field.
      // Each document paragraph gets its own button so the user can create a
      // document and have it auto-fill THIS paragraph's Document select without
      // scrolling to the top of the page. The modal link carries this select's
      // DOM id as ?target= ; on save the modal appends + selects the new
      // document option in that select (see CustomAddDocument).
      // Tag THIS paragraph's Document <select> with a unique data attribute so
      // the modal can find + fill it. data-* attributes (unlike id) are not
      // overwritten by Drupal's auto #id, and don't depend on a wrapper div
      // rendering inside the IEF subform (the #prefix wrapper did not render).
      $doc_token = 'job-doc';
      foreach ($element['subform']['field_doc_notice_period']['widget']['#parents'] as $value) {
        $doc_token .= is_int($value) ? '-' . $value : '';
      }
      $element['subform']['field_document']['widget']['#attributes']['data-doc-select'] = $doc_token;

      // A document created via the modal is injected into the <select> client
      // side, but the server's options_select option list is built before it
      // exists, so the value would fail validation ("submitted value N ... is
      // not allowed") on the next rebuild/save. This #after_build re-adds the
      // selected document to #options so it validates.
      $element['subform']['field_document']['widget']['#after_build'][] = '_associatedps_forms_ensure_document_option';

      $doc_weight = $element['subform']['field_document']['#weight'] ?? 0;
      $element['subform']['create_new_document'] = [
        '#type' => 'link',
        '#title' => t('Create New Document'),
        '#url' => Url::fromUri('base://add-document/0', [
          'query' => ['job_nid' => $nid, 'target' => $doc_token],
        ]),
        '#attributes' => [
          'class' => ['use-ajax', 'button', 'create-new-document-inline'],
          'data-dialog-type' => 'modal',
          'data-dialog-options' => '{"width":800}',
        ],
        '#weight' => $doc_weight + 0.01,
      ];
    }

    /* standard fee base on types of service's standard fee.*/
    if (isset($element['#paragraph_type']) && $element['#paragraph_type'] == 'job_fees') {

      $element['subform']['calculate_button'] = [
        '#type' => 'html_tag',
        '#tag' => 'input',
        '#attributes' => [
          'type' => 'button',
          'value' => 'Calculate',
          'class' => 'calculate-button',
          'name' => 'calculate_button',
        ],
        '#weight' => '2',
      ];

      // Standard fee population is handled client-side by the
      // service_fee_sync JS library via drupalSettings.
    }

    /* Employee default value based on Allocated To.
     * Handled entirely client-side by the employee_sync JS library
     * via drupalSettings. Covers both scenarios:
     * - Allocated To selected before paragraph is generated
     * - Allocated To changed after paragraph is already open */
    if (isset($element['#paragraph_type']) && $element['#paragraph_type'] == 'employee') {

      if ($nid > 0 && isset($element['subform']['field_party_to_serve_addresses'])) {
        $node = Node::load($nid);
        if ($node && !empty($node->field_service_address->getValue())) {
          $address = [];
          $default = [];
          $addresses = $node->field_service_address->getValue();
          foreach ($addresses as $add) {
            $add_para = Paragraph::load($add['target_id']);
            $add_value = $add_para->field_service_address->getValue();
            $add_value = reset($add_value);

            $address[$add_value['address_line1'] . '-' . $add_value['locality'] . '-' . $add_value['administrative_area'] . '-' . $add_value['postal_code']] = $add_value['address_line1'];
            $default[] = $add_value['address_line1'] . '-' . $add_value['locality'] . '-' . $add_value['administrative_area'] . '-' . $add_value['postal_code'];
          }
          $add = explode('-', $default[0]);
          if (($element['subform']['field_party_to_serve_addresses']['widget']['#default_value'] == []) && ($element['subform']['field_address_attendance']['widget'][0]['address']['#default_value']['address_line1'] == "")) {
            $element['subform']['field_party_to_serve_addresses']['widget']['#default_value'] = $default[0];
            $element['subform']['field_address_attendance']['widget'][0]['address']['#default_value']['address_line1'] = $add[0];
            $element['subform']['field_address_attendance']['widget'][0]['address']['#default_value']['locality'] = $add[1];
            $element['subform']['field_address_attendance']['widget'][0]['address']['#default_value']['administrative_area'] = $add[2];
            $element['subform']['field_address_attendance']['widget'][0]['address']['#default_value']['postal_code'] = $add[3];
          }
          $element['subform']['field_party_to_serve_addresses']['widget']['#options'] = $address;
          // Stash the current job's address list so the after_build can restrict
          // the rendered options to it (the field's global allowed_values lists
          // every job's addresses).
          $element['subform']['field_party_to_serve_addresses']['widget']['#aps_job_addresses'] = $address;
          $element['subform']['field_party_to_serve_addresses']['widget']['#after_build'][] = '_associatedps_forms_after_build_paragraph_select_or_other';
        }
      }
    }

    if (isset($element['#paragraph_type']) && $element['#paragraph_type'] == 'addresses') {
      // Override the paragraph summary to show the full address instead of
      // the internal DB ID.
      $paragraph_entity = $context['items'][$context['delta']]->entity ?? NULL;
      if ($paragraph_entity && $paragraph_entity->id()) {
        $addr_values = $paragraph_entity->get('field_service_address')->getValue();
        if (!empty($addr_values)) {
          $addr = reset($addr_values);
          $parts = array_filter([
            $addr['address_line1'] ?? '',
            $addr['locality'] ?? '',
            $addr['administrative_area'] ?? '',
            $addr['postal_code'] ?? '',
          ]);
          if (!empty($parts)) {
            $summary_text = implode(', ', $parts);
            $element['top']['summary']['fields_info'] = [
              '#markup' => '<span class="summary-content">' . htmlspecialchars($summary_text) . '</span>',
            ];
          }
        }
      }
    }

    if (isset($element['#paragraph_type']) && $element['#paragraph_type'] == 'address') {
      $node = Node::load($nid);
      if ($nid > 0 && isset($element['subform']['field_party_to_serve_addresses'])) {
        if (!empty($node->field_service_address->getValue())) {
          $address = [];
          $default = [];
          $addresses = $node->field_service_address->getValue();
          foreach ($addresses as $add) {
            $add_para = Paragraph::load($add['target_id']);
            $add_value = $add_para->field_service_address->getValue();
            $add_value = reset($add_value);

            $address[$add_value['address_line1'] . '-' . $add_value['locality'] . '-' . $add_value['administrative_area'] . '-' . $add_value['postal_code']] = $add_value['address_line1'];
            $default[] = $add_value['address_line1'] . '-' . $add_value['locality'] . '-' . $add_value['administrative_area'] . '-' . $add_value['postal_code'];
          }
          $add = explode('-', $default[0]);
          if (($element['subform']['field_party_to_serve_addresses']['widget']['#default_value'] == []) && ($element['subform']['field_address']['widget'][0]['address']['#default_value']['address_line1'] == "")) {
            $element['subform']['field_party_to_serve_addresses']['widget']['#default_value'] = $default[0];
            $element['subform']['field_address']['widget'][0]['address']['#default_value']['address_line1'] = $add[0];
            $element['subform']['field_address']['widget'][0]['address']['#default_value']['locality'] = $add[1];
            $element['subform']['field_address']['widget'][0]['address']['#default_value']['administrative_area'] = $add[2];
            $element['subform']['field_address']['widget'][0]['address']['#default_value']['postal_code'] = $add[3];
          }
          $element['subform']['field_party_to_serve_addresses']['widget']['#options'] = $address;
          // Restrict the rendered options to THIS job's addresses (the field's
          // global allowed_values otherwise lists every job's addresses).
          $element['subform']['field_party_to_serve_addresses']['widget']['#aps_job_addresses'] = $address;
          $element['subform']['field_party_to_serve_addresses']['widget']['#after_build'][] = '_associatedps_forms_after_build_paragraph_select_or_other';
        }
      }
    }
  }
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 */
function associatedps_forms_inline_entity_form_table_fields_alter(&$fields, $context) {
  if ($context['field_name'] == 'field_service_address' && isset($fields['label'])) {
    $fields['label']['label'] = t('Address');
  }

  // Attendance Notes list: replace the "Label" column (which showed the
  // paragraph label "Job … → Attendance Notes") with two columns — Date and
  // Time — both derived from field_date_time. The Operations column is appended
  // by IEF and is kept as-is. (Works because attendance_note has no enabled
  // ief_table view-mode display, so this alter is not overwritten by the
  // ief_table_view_mode handler.)
  if ($context['field_name'] === 'field_attendance_notes') {
    unset($fields['label']);
    $fields['attendance_date'] = [
      'type' => 'callback',
      'label' => t('Date'),
      'callback' => '_associatedps_forms_attendance_table_date',
      'weight' => 1,
    ];
    $fields['attendance_time'] = [
      'type' => 'callback',
      'label' => t('Time'),
      'callback' => '_associatedps_forms_attendance_table_time',
      'weight' => 2,
    ];
  }
}

/**
 * IEF table callback: the Date part of an attendance note's field_date_time.
 */
function _associatedps_forms_attendance_table_date($entity, $variables) {
  return ['#markup' => _associatedps_forms_attendance_dt_format($entity, 'd/m/Y')];
}

/**
 * IEF table callback: the Time part of an attendance note's field_date_time.
 */
function _associatedps_forms_attendance_table_time($entity, $variables) {
  return ['#markup' => _associatedps_forms_attendance_dt_format($entity, 'h:i A')];
}

/**
 * Format an attendance note's field_date_time (stored UTC) in the site
 * timezone with the given PHP date format. Returns '' when empty/unparseable.
 */
function _associatedps_forms_attendance_dt_format($entity, $format) {
  if (!$entity->hasField('field_date_time') || $entity->get('field_date_time')->isEmpty()) {
    return '';
  }
  $raw = $entity->get('field_date_time')->value;
  // 'datetime' fields store 'Y-m-d\TH:i:s' in UTC.
  $ts = strtotime($raw . ' UTC');
  return $ts ? \Drupal::service('date.formatter')->format($ts, 'custom', $format) : '';
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function associatedps_forms_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$form_state) {
  if ($entity_form['#entity_type'] == 'paragraph' && isset($entity_form['#ief_labels']) && in_array('field_service_address', $entity_form['#parents'], TRUE)) {
    $entity_form['#ief_labels']['singular'] = t('Address');
    $entity_form['#ief_labels']['plural'] = t('Addresses');
  }
  // Rename IEF labels for Job Fees and add after_build to override button text.
  if ($entity_form['#entity_type'] == 'paragraph' && in_array('field_job_fees', $entity_form['#parents'], TRUE)) {
    $entity_form['#ief_labels']['singular'] = t('Fee');
    $entity_form['#ief_labels']['plural'] = t('Fees');
    $entity_form['#after_build'][] = '_associatedps_forms_after_build_ief_job_fees';
  }
  // Attendance Notes: rename the inline add/edit save buttons to Create/Update
  // Attendance. (The widget-level "Add new …" button is renamed in the job form
  // after_build, _associatedps_forms_job_form_after_build.)
  if ($entity_form['#entity_type'] == 'paragraph' && in_array('field_attendance_notes', $entity_form['#parents'], TRUE)) {
    $entity_form['#ief_labels']['singular'] = t('Attendance');
    $entity_form['#ief_labels']['plural'] = t('Attendances');
    $entity_form['#after_build'][] = '_associatedps_forms_after_build_ief_attendance';
  }
}

/**
 * Ajax callback associatedps_forms_change_standard_fees().
 */
function associatedps_forms_change_standard_fees(array & $element, FormStateInterface $form_state) {

  $type_of_service = $form_state->getTriggeringElement();
  $service = $type_of_service['#value'];
  $std_fees = '';
  if (!empty($service)) {
    $service_id = reset($service);
    $service_term = Term::load($service_id);
    $std_fees = $service_term->field_standard_fee->value;
  }
  $wrapper_id = $type_of_service["#ajax"]["wrapper"];
  $response = new AjaxResponse();
  $response->addCommand(new InvokeCommand("#" . $wrapper_id, 'val', [$std_fees]));
  return $response;
}

/**
 * Ajax callback associatedps_forms_change_notice_period().
 */
function associatedps_forms_change_notice_period(array & $element, FormStateInterface $form_state) {

  $document = $form_state->getTriggeringElement();
  $doc_node = $document['#value'];
  $notice_period = '';
  if (!empty($doc_node)) {
    // field_document is now a Chosen <select>, so #value is the selected node id
    // (a string); the old autocomplete widget passed an array. Handle both.
    $doc_node_id = is_array($doc_node) ? reset($doc_node) : $doc_node;
    $node_doc = Node::load($doc_node_id);
    if ($node_doc) {
      $notice_period = $node_doc->field_notice_period->value;
    }
  }
  $wrapper_id = $document["#ajax"]["wrapper"];
  $response = new AjaxResponse();
  $response->addCommand(new InvokeCommand("#" . $wrapper_id, 'val', [$notice_period]));
  return $response;
}

/**
 * #after_build for the document paragraph's Document select.
 *
 * Ensures the currently-selected document is present in the select's #options.
 * A document created via the per-paragraph "Create New Document" modal is added
 * to the <select> client side, but the server-built option list does not yet
 * contain it, so options_select would reject the value as "not allowed" on the
 * next rebuild (Add Another / notice-period ajax) or on save. Re-adding it here
 * keeps the value valid.
 */
function _associatedps_forms_ensure_document_option($element, FormStateInterface $form_state) {
  $value = $element['#value'] ?? NULL;
  // Single-value select gives a scalar; guard against arrays/empty/_none so the
  // value can be safely used as an #options offset.
  if (is_scalar($value) && $value !== '' && $value !== '_none' && !isset($element['#options'][$value])) {
    $doc = Node::load($value);
    if ($doc && $doc->bundle() === 'document') {
      $element['#options'][$value] = $doc->label();
    }
  }
  return $element;
}

/**
 * Implements hook_field_group_pre_render_alter().
 *
 * Job VIEW page: title each section (field group) with the LIVE label of the
 * matching edit-form group, so renaming a tab/section on the Job form updates
 * the view section title automatically — no hardcoded titles, no CSS content
 * hacks. The view display and form display are independent configs, so the
 * structural view-group -> form-group map is explicit; only the label text is
 * read dynamically from the form display.
 */
function associatedps_forms_field_group_pre_render_alter(array &$element, &$group, &$rendering_object) {
  if (($group->context ?? '') !== 'view'
    || ($group->entity_type ?? '') !== 'node'
    || ($group->bundle ?? '') !== 'job') {
    return;
  }

  // View field group  =>  edit-form field group whose label to mirror.
  $map = [
    'group_case_details'            => 'group_job_detail',       // tab "Client"
    'group_court_details'           => 'group_court_detail',     // tab "Court"
    'group_party_details'           => 'group_party',            // tab "Parties"
    'group_document_details'        => 'group_documents',        // tab "Documents"
    'group_served_party_details'    => 'group_party_to_serve',   // tab "Party To Serve"
    'group_job_status'              => 'group_job__status',      // tab "Job Status"
    'group_attendance_note_details' => 'group_attendance_note',  // tab "Attendance Note"
    'group_service_details'         => 'group_service_details',  // fieldset "Service Details" (no own tab)
  ];

  if (!isset($map[$group->group_name])) {
    return;
  }

  // Read the edit-form field group definitions once per request.
  $form_groups = &drupal_static(__FUNCTION__);
  if (!isset($form_groups)) {
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.job.default');
    $form_groups = $form_display ? ($form_display->getThirdPartySettings('field_group') ?: []) : [];
  }

  $form_group_name = $map[$group->group_name];
  if (!empty($form_groups[$form_group_name]['label'])) {
    $element['#title'] = $form_groups[$form_group_name]['label'];
  }
}

/**
 * Implements hook_entity_presave().
 */
function associatedps_forms_node_presave(NodeInterface $node) {
  if ($node->getType() == 'job') {
    // Accumulate custom ("Other") Person Delivered To values into a global State
    // list so they stay reusable as dropdown options across jobs. A value is
    // "custom" when it is not one of THIS job's party names.
    $party_names = [];
    foreach (['field_parties', 'field_party_2', 'field_other_parties'] as $pf) {
      if ($node->hasField($pf)) {
        foreach ($node->get($pf)->referencedEntities() as $para) {
          $fn = $para->hasField('field_name') ? trim((string) $para->get('field_name')->value) : '';
          $ln = $para->hasField('field_last_name') ? trim((string) $para->get('field_last_name')->value) : '';
          $full = trim($fn . ' ' . $ln);
          if ($full !== '') {
            $party_names[$full] = TRUE;
          }
        }
      }
    }
    // Custom ("Other") Person Delivered To values are no longer accumulated into
    // global State — that pooled custom names across ALL jobs and leaked them
    // into every job's dropdown. Each job keeps only its own saved value
    // (re-added to options in form_alter).

    $client_name = isset($_COOKIE['Drupal_visitor_client_name']) ? $_COOKIE['Drupal_visitor_client_name'] : '';
    $client_id = isset($_COOKIE['Drupal_visitor_client_id']) ? $_COOKIE['Drupal_visitor_client_id'] : '';
    $telephone = isset($_COOKIE['Drupal_visitor_telephone']) ? $_COOKIE['Drupal_visitor_telephone'] : '';
    $generic_email = isset($_COOKIE['Drupal_visitor_generic_email']) ? $_COOKIE['Drupal_visitor_generic_email'] : '';
    $discount = isset($_COOKIE['Drupal_visitor_discount']) ? $_COOKIE['Drupal_visitor_discount'] : '';
    $notes = isset($_COOKIE['Drupal_visitor_notes']) ? $_COOKIE['Drupal_visitor_notes'] : '';
    $sa_address_line1 = isset($_COOKIE['Drupal_visitor_sa_address_line1']) ? $_COOKIE['Drupal_visitor_sa_address_line1'] : '';
    $sa_address_line2 = isset($_COOKIE['Drupal_visitor_sa_address_line2']) ? $_COOKIE['Drupal_visitor_sa_address_line2'] : '';
    $sa_locality = isset($_COOKIE['Drupal_visitor_sa_locality']) ? $_COOKIE['Drupal_visitor_sa_locality'] : '';
    $sa_postal_code = isset($_COOKIE['Drupal_visitor_sa_postal_code']) ? $_COOKIE['Drupal_visitor_sa_postal_code'] : '';
    $sa_administrative_area = isset($_COOKIE['Drupal_visitor_sa_administrative_area']) ? $_COOKIE['Drupal_visitor_sa_administrative_area'] : '';
    $node_id = isset($_COOKIE['Drupal_visitor_node_id']) ? $_COOKIE['Drupal_visitor_node_id'] : '';
    $client_submit = isset($_COOKIE['Drupal_visitor_client_submit']) ? $_COOKIE['Drupal_visitor_client_submit'] : 0;
    $nid = 0;
    if ($node->get('field_client')->getValue()) {
      $nid = (int) $node->get('field_client')->getValue()[0]['target_id'];
    }
    if ($nid > 0) {
      $node_client = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
      $node_id = $nid;
      $client_name = $node_client->getTitle();
      $client_id = !empty($node_client->get('field_client_id')->getValue()) ? $node_client->get('field_client_id')->getValue()[0]['value'] : 0;
      $telephone = !empty($node_client->get('field_telephone')->getValue()) ? $node_client->get('field_telephone')->getValue()[0]['value'] : '';
      $generic_email = !empty($node_client->get('field_email')->getValue()) ? $node_client->get('field_email')->getValue()[0]['value'] : '';
      $discount = !empty($node_client->get('field_agreed_discount')->getValue()) ? $node_client->get('field_agreed_discount')->getValue()[0]['value'] : '';
      $notes = !empty($node_client->get('field_notes')->getValue()) ? $node_client->get('field_notes')->getValue()[0]['value'] : '';
      if (!empty($node_client->get('field_client_address')->getValue())) {
        $sa_address_line1 = $node_client->get('field_client_address')->getValue()[0]['address_line1'];
        $sa_address_line2 = $node_client->get('field_client_address')->getValue()[0]['address_line2'];
        $sa_locality = $node_client->get('field_client_address')->getValue()[0]['locality'];
        $sa_postal_code = $node_client->get('field_client_address')->getValue()[0]['postal_code'];
        $sa_administrative_area = $node_client->get('field_client_address')->getValue()[0]['administrative_area'];
      }
      $client_submit = 1;
    }

    if ($client_submit != 0) {
      $node->field_client_cid->value = $node_id;
      $node->field_client_name->value = $client_name;
      $node->field_job_client_id->value = $client_id;
      $node->field_email->value = $generic_email;
      $node->field_telephone->value = $telephone;
      $node->field_agreed_discount->value = $discount;
      $node->field_notes = [
        'value' => $notes,
        'format' => 'full_html',
      ];
      $node->field_client_address->address_line1 = $sa_address_line1;
      $node->field_client_address->address_line2 = $sa_address_line2;
      $node->field_client_address->locality = $sa_locality;
      $node->field_client_address->administrative_area = $sa_administrative_area;
      $node->field_client_address->postal_code = $sa_postal_code;
    }

    if ($node_id != '') {
      $node->field_client->target_id = $node_id;
    }

    $reset_value = [
      'client_submit' => 0,
      'client_name' => '',
      'client_id' => '',
      'telephone' => '',
      'generic_email' => '',
      'discount' => '',
      'notes' => '',
      'sa_address_line1' => '',
      'sa_address_line2' => '',
      'sa_locality' => '',
      'sa_postal_code' => '',
      'sa_administrative_area' => '',
    ];
    user_cookie_save($reset_value);

    if ((!empty($node->field_client_cid->value)) && empty($node->field_client->getValue())) {
      $node->field_client[] = ['target_id' => $node->field_client_cid->value];
    }

    // Attach document created via modal to the job as a new paragraph.
    $cookie_doc_nid = isset($_COOKIE['Drupal_visitor_node_doc_id']) ? $_COOKIE['Drupal_visitor_node_doc_id'] : '';
    $cookie_doc_submit = isset($_COOKIE['Drupal_visitor_document_submit']) ? $_COOKIE['Drupal_visitor_document_submit'] : 0;
    if (!empty($cookie_doc_nid) && $cookie_doc_submit != 0) {
      $doc_node = Node::load($cookie_doc_nid);
      if ($doc_node) {
        $paragraph = Paragraph::create(['type' => 'document']);
        $paragraph->set('field_document', ['target_id' => $cookie_doc_nid]);
        $paragraph->set('field_document_title', $doc_node->getTitle());
        $paragraph->set('field_notice_period', $doc_node->field_notice_period->value ?? '');
        $paragraph->set('field_court_name', $doc_node->field_court_name->target_id ? ['target_id' => $doc_node->field_court_name->target_id] : []);
        $paragraph->set('field_affidavit_template', $doc_node->field_affidavit_template->target_id ? ['target_id' => $doc_node->field_affidavit_template->target_id] : []);
        $paragraph->save();
        $node->field_documents[] = [
          'target_id' => $paragraph->id(),
          'target_revision_id' => $paragraph->getRevisionId(),
        ];
      }
      user_cookie_save([
        'document_submit' => 0,
        'node_doc_id' => '',
        'document_title' => '',
        'notice_period' => '',
        'court_name' => '',
        'affidavit_template' => '',
      ]);
      // Clear the raw cookie set by CustomAddDocument.
      setcookie('create_doc_for_job', '', time() - 3600, '/');
    }

    $document = $node->get('field_documents')->getValue();
    foreach ($document as $dc) {
      if ((int) $dc['target_id'] > 0) {
        $prag = Paragraph::load($dc['target_id']);
        $dc_value = $prag->field_document->getValue();
        if (!empty($dc_value)) {
          $dc_value = reset($dc_value);
          $node_dc = \Drupal::entityTypeManager()->getStorage('node')->load($dc_value['target_id']);
          if (!empty($node_dc)) {
            $court_name = $node_dc->field_court_name->target_id;
            $aff_template = $node_dc->field_affidavit_template->target_id;
            $dc_title = $node_dc->getTitle();
            $dc_notice = isset($node_dc->field_notice_period->getValue()[0]['value']) ? $node_dc->field_notice_period->getValue()[0]['value'] : '';
            $prag->field_document_title->value = $dc_title;
            $prag->field_notice_period->value = $dc_notice;
            $prag->field_court_name[] = ['target_id' => $court_name];
            $prag->field_affidavit_template[] = ['target_id' => $aff_template];
            $prag->save();
          }
        }
      }
    }
  }
  //var_dump("end of associatedps_forms_node_presave"."<br/>");
}

/**
 * Entity builder: reconcile Job Status <-> Attendance service-detail fields.
 *
 * Runs during form submit (buildEntity), BEFORE the node is saved — crucially
 * before the entity_reference_revisions field preSave overwrites the existing
 * address paragraph in place. That timing is what makes change detection work
 * on EDIT: a fresh loadUnchanged() of the node still holds the pre-edit address,
 * so an edited address is correctly detected and copied.
 */
function _associatedps_forms_service_details_entity_builder($entity_type, NodeInterface $node, &$form, FormStateInterface $form_state) {
  if ($node->getType() !== 'job') {
    return;
  }
  // Only act on a real full-page submit, not the AJAX widget rebuilds
  // (add/remove paragraph, IEF open/close), which also call buildEntity.
  if (\Drupal::request()->isXmlHttpRequest()) {
    return;
  }
  // Load a clean copy of the stored node; its paragraphs are not yet overwritten
  // by this save, so they carry the genuine pre-edit values for comparison.
  $original = NULL;
  if (!$node->isNew()) {
    $original = \Drupal::entityTypeManager()->getStorage('node')->loadUnchanged($node->id());
  }
  // Original address signatures captured in form_alter (pre-edit, reliable).
  $orig_job_addr_sig = $form_state->get('aps_orig_job_addr_sig');
  $orig_att_addr_sig = $form_state->get('aps_orig_att_addr_sig');
  _associatedps_forms_sync_service_details($node, $original, $orig_job_addr_sig, $orig_att_addr_sig);
}

/**
 * Reconcile the Job Status and Attendance Note service-detail field sets.
 *
 * The Attendance Note tab carries a copy of the Job Status "Service Details"
 * fields (plus its own Case Status). The two sets are kept identical, resolved
 * here on save:
 *   - if only one tab's field changed, that value flows to the other tab;
 *   - if BOTH changed the same field in one save, the Attendance value wins.
 *
 * Change is detected per field against $node->original (the pre-edit values),
 * which also makes future per-tab field access control safe: a tab the user
 * cannot edit keeps its original values (unchanged), so the other tab
 * correctly propagates.
 */
function _associatedps_forms_sync_service_details(NodeInterface $node, $original = NULL, $origJobAddrSig = NULL, $origAttAddrSig = NULL) {
  if ($node->getType() !== 'job') {
    return;
  }

  // Job Status field => Attendance Note field (simple value fields).
  $pairs = [
    'field_case_status'              => 'field_attendance_case_status',
    'field_served_by'                => 'field_attendance_served_by',
    'field_method_of_service'        => 'field_attendance_method_of_servi',
    'field_person_delivered_to'      => 'field_atten_person_delivered_to',
    'field_person_delivered_value'   => 'field_atten_person_delivered_val',
    'field_service_details_position' => 'field_atten_service_details_pos',
    'field_business_name'            => 'field_atten_business_name',
    'field_business_name_value'      => 'field_atten_business_name_value',
    'field_notes2'                   => 'field_attendance_notes2',
    'field_date_service'             => 'field_attendance_date_service',
  ];

  foreach ($pairs as $jobField => $attField) {
    if (!$node->hasField($jobField) || !$node->hasField($attField)) {
      continue;
    }

    $jobVal = $node->get($jobField)->getValue();
    $attVal = $node->get($attField)->getValue();
    $jobOrig = ($original && $original->hasField($jobField)) ? $original->get($jobField)->getValue() : [];
    $attOrig = ($original && $original->hasField($attField)) ? $original->get($attField)->getValue() : [];

    $jobChanged = ($jobVal != $jobOrig);
    $attChanged = ($attVal != $attOrig);

    if ($attChanged) {
      // Attendance precedence — covers "attendance only" and "both changed".
      if ($jobVal != $attVal) {
        $node->set($jobField, $attVal);
      }
    }
    elseif ($jobChanged) {
      if ($jobVal != $attVal) {
        $node->set($attField, $jobVal);
      }
    }
  }

  // Address Served — both fields are entity_reference_revisions (paragraph).
  // Detect change by the address CONTENT (not just the reference id) so an
  // in-place edit of the same paragraph is caught, then copy by duplicating
  // the paragraph so each field owns its own copy.
  $jobAddr = 'field_para_address';
  $attAddr = 'field_attendance_address_served';
  if ($node->hasField($jobAddr) && $node->hasField($attAddr)) {
    $jobSig = _associatedps_forms_address_signature($node, $jobAddr);
    $attSig = _associatedps_forms_address_signature($node, $attAddr);
    // Prefer the signatures captured in form_alter (reliable pre-edit values);
    // fall back to $original only when not provided (e.g. programmatic saves).
    $jobOrigSig = $origJobAddrSig !== NULL ? $origJobAddrSig : ($original ? _associatedps_forms_address_signature($original, $jobAddr) : '');
    $attOrigSig = $origAttAddrSig !== NULL ? $origAttAddrSig : ($original ? _associatedps_forms_address_signature($original, $attAddr) : '');

    $jobAddrChanged = ($jobSig !== $jobOrigSig);
    $attAddrChanged = ($attSig !== $attOrigSig);

    if ($attAddrChanged && $jobSig !== $attSig) {
      _associatedps_forms_copy_paragraph_field($node, $attAddr, $jobAddr);
    }
    elseif ($jobAddrChanged && $jobSig !== $attSig) {
      _associatedps_forms_copy_paragraph_field($node, $jobAddr, $attAddr);
    }
  }
}

/**
 * Build a comparable signature of an address paragraph's address columns.
 *
 * @param \Drupal\Core\Entity\FieldableEntityInterface $node
 *   The node (or $node->original) to read from.
 * @param string $field
 *   The paragraph reference field name.
 *
 * @return string
 *   A stable string of the address columns, or '' when there is no address.
 */
function _associatedps_forms_address_signature($node, $field) {
  if (!$node->hasField($field) || $node->get($field)->isEmpty()) {
    return '';
  }
  $para = $node->get($field)->entity;
  if (!$para) {
    return '';
  }

  // The "address" paragraph bundle has THREE editable subfields, all watched so
  // a change to any one triggers the copy:
  //   field_address                  (Service Address — full address columns)
  //   field_party_to_serve_addresses (Party to Serve Addresses — list_string)
  //   field_selected_address         (Selected Address — string)
  $parts = [];

  if ($para->hasField('field_address') && !$para->get('field_address')->isEmpty()) {
    $a = $para->get('field_address')->first()->getValue();
    $keys = [
      'country_code', 'administrative_area', 'locality', 'dependent_locality',
      'postal_code', 'sorting_code', 'address_line1', 'address_line2',
      'organization', 'given_name', 'family_name',
    ];
    foreach ($keys as $k) {
      $parts[] = isset($a[$k]) ? trim((string) $a[$k]) : '';
    }
  }
  else {
    $parts[] = '';
  }

  $parts[] = ($para->hasField('field_party_to_serve_addresses') && !$para->get('field_party_to_serve_addresses')->isEmpty())
    ? trim((string) $para->get('field_party_to_serve_addresses')->value) : '';
  $parts[] = ($para->hasField('field_selected_address') && !$para->get('field_selected_address')->isEmpty())
    ? trim((string) $para->get('field_selected_address')->value) : '';

  return implode('|', $parts);
}

/**
 * Copy a paragraph reference between two node fields by duplicating it.
 *
 * A paragraph cannot be shared by two parent fields, so the referenced
 * paragraph is duplicated and the new copy assigned to the target.
 *
 * This runs in an entity builder, BEFORE the node save (and therefore before
 * the entity_reference_revisions field preSave). Assigning the unsaved
 * duplicate is enough — the ERR field saves it and fills in
 * target_id/target_revision_id during the node save, the standard paragraph
 * flow.
 */
function _associatedps_forms_copy_paragraph_field($node, $sourceField, $targetField) {
  if ($node->get($sourceField)->isEmpty() || !$node->get($sourceField)->entity) {
    $node->set($targetField, []);
    return;
  }
  $dup = $node->get($sourceField)->entity->createDuplicate();
  $dup->enforceIsNew(TRUE);
  $node->set($targetField, $dup);
}

/**
 * After build: rename IEF "Create Paragraph" to "Save Fee" for Job Fees.
 */
function _associatedps_forms_after_build_ief_job_fees($element, FormStateInterface $form_state) {
  if (isset($element['actions']['ief_add_save'])) {
    $element['actions']['ief_add_save']['#value'] = t('Save Fee');
  }
  if (isset($element['actions']['ief_edit_save'])) {
    $element['actions']['ief_edit_save']['#value'] = t('Save Fee');
  }
  return $element;
}

/**
 * After build: rename IEF add/edit save buttons for Attendance Notes.
 */
function _associatedps_forms_after_build_ief_attendance($element, FormStateInterface $form_state) {
  if (isset($element['actions']['ief_add_save'])) {
    $element['actions']['ief_add_save']['#value'] = t('Create Attendance');
  }
  if (isset($element['actions']['ief_edit_save'])) {
    $element['actions']['ief_edit_save']['#value'] = t('Update Attendance');
  }
  return $element;
}

/**
 * After build callback to fix horizontal tabs group mechanism.
 */
function _associatedps_forms_job_form_after_build($form, FormStateInterface $form_state) {
  $groups = &$form_state->getGroups();
  if (isset($groups['group_job'])) {
    $groups['group_job']['#group_exists'] = TRUE;
  }
  // Rename the Attendance Notes IEF "Add new …" button to "Add New Attendance".
  if (isset($form['field_attendance_notes']['widget']['actions']['ief_add'])) {
    $form['field_attendance_notes']['widget']['actions']['ief_add']['#value'] = t('Add New Attendance');
  }

  return $form;
}

/**
 * Form-level #after_build: fix dynamically-added address values in IEF
 * paragraph subforms.
 *
 * hook_field_widget_single_element_form_alter does NOT fire for IEF
 * attendance_note/address paragraphs during AJAX. This callback runs after
 * the entire form tree is built (including all IEF subforms) but before
 * validation. It recursively finds field_party_to_serve_addresses select
 * elements and injects their submitted value into #options so that
 * performRequiredValidation() accepts them.
 */
function _associatedps_forms_after_build_fix_ief_address_selects($form, FormStateInterface $form_state) {
  // Build THIS job's service-address option list once, so every
  // field_party_to_serve_addresses select (incl. the IEF-rendered Service
  // Details popups, where the widget alter hook does not fire) can be
  // restricted to it — the field's global allowed_values otherwise lists
  // addresses from every job.
  $job_addresses = [];
  $job = $form_state->getFormObject()->getEntity();
  if ($job instanceof NodeInterface && $job->hasField('field_service_address')) {
    foreach ($job->get('field_service_address')->referencedEntities() as $addr_para) {
      if (!$addr_para->hasField('field_service_address') || $addr_para->get('field_service_address')->isEmpty()) {
        continue;
      }
      $a = $addr_para->get('field_service_address')->first()->getValue();
      $key = ($a['address_line1'] ?? '') . '-' . ($a['locality'] ?? '') . '-' . ($a['administrative_area'] ?? '') . '-' . ($a['postal_code'] ?? '');
      $job_addresses[$key] = $a['address_line1'] ?? $key;
    }
  }
  _associatedps_forms_recurse_fix_address_selects($form, $job_addresses);
  return $form;
}

/**
 * Recursively walk the form tree looking for field_party_to_serve_addresses
 * select elements, restrict their options to this job's addresses, and inject
 * the submitted value into #options.
 */
function _associatedps_forms_recurse_fix_address_selects(&$elements, array $job_addresses = []) {
  foreach (\Drupal\Core\Render\Element::children($elements) as $key) {
    if ($key === 'field_party_to_serve_addresses') {
      // Found the field — look for widget > select inside it.
      _associatedps_forms_inject_address_option($elements[$key], $job_addresses);
    }
    // Recurse into children.
    if (is_array($elements[$key])) {
      _associatedps_forms_recurse_fix_address_selects($elements[$key], $job_addresses);
    }
  }
}

/**
 * For a field_party_to_serve_addresses render array, restrict the inner select's
 * #options to THIS job's service addresses (the field's global allowed_values
 * lists every job's addresses) and keep the submitted value so it validates.
 */
function _associatedps_forms_inject_address_option(&$field_element, array $job_addresses = []) {
  // The widget is at ['widget'] (WidgetBase::form wraps in a container).
  // Inside, the select_or_other element has a 'select' child.
  $widget = &$field_element;
  if (isset($field_element['widget'])) {
    $widget = &$field_element['widget'];
  }

  // The inner select created by processSelectOrOther().
  if (!isset($widget['select']['#options'])) {
    return;
  }

  // Restrict the options to this job's addresses. Order: "- None -" (if any)
  // first, then the addresses, then "- Other -" LAST — otherwise the dropdown
  // defaults to "- Other -" on a new paragraph (which has no preset value).
  $existing = $widget['select']['#options'];
  $restricted = [];
  if (isset($existing['_none'])) {
    $restricted['_none'] = $existing['_none'];
  }
  $restricted += $job_addresses;
  if (isset($existing['select_or_other'])) {
    $restricted['select_or_other'] = $existing['select_or_other'];
  }
  $widget['select']['#options'] = $restricted;
  if (isset($widget['#options'])) {
    $widget['#options'] = $restricted;
  }

  // Keep the currently-selected value so it still validates / displays
  // (e.g. a custom "Other" address, or a value saved earlier).
  $value = $widget['select']['#value'] ?? NULL;
  if (!empty($value) && is_string($value) && $value !== '_none' && $value !== 'select_or_other') {
    if (!isset($widget['select']['#options'][$value])) {
      $widget['select']['#options'][$value] = $value;
    }
    if (isset($widget['#options']) && !isset($widget['#options'][$value])) {
      $widget['#options'][$value] = $value;
    }
    // Ensure field storage allowed_values has this value (entity validation).
    _associatedps_forms_ensure_party_address_allowed($value);
  }
}

/**
 * Generic after-build callback for select_or_other widgets.
 *
 * Reads the submitted select value from user input and adds it to BOTH the
 * parent widget's #options and the inner select's #options so that Drupal's
 * performRequiredValidation() accepts values dynamically added by JS.
 *
 * Works for any select_or_other field by reading the field name from #parents.
 */
function _associatedps_forms_after_build_select_or_other($element, FormStateInterface $form_state) {
  $input = $form_state->getUserInput();
  $field_name = $element['#parents'][0] ?? '';
  $value = $input[$field_name]['select'] ?? '';
  if (!empty($value) && $value !== 'select_or_other') {
    // Add to parent widget's #options (validates as array #value).
    if (isset($element['#options']) && !isset($element['#options'][$value])) {
      $element['#options'][$value] = $value;
    }
    // Add to inner select's #options (validates as select #value).
    if (isset($element['select']['#options']) && !isset($element['select']['#options'][$value])) {
      $element['select']['#options'][$value] = $value;
    }
  }
  return $element;
}

/**
 * After-build callback for select_or_other fields inside paragraph subforms.
 *
 * Unlike _associatedps_forms_after_build_select_or_other() which only works
 * for top-level form fields, this uses NestedArray::getValue() to traverse
 * the full #parents path, so it works for deeply nested paragraph subform
 * fields like field_party_to_serve_addresses inside attendance_note/address
 * paragraphs.
 */
function _associatedps_forms_after_build_paragraph_select_or_other($element, FormStateInterface $form_state) {
  $input = $form_state->getUserInput();
  $select_parents = array_merge($element['#parents'] ?? [], ['select']);

  // Collect submitted values from multiple sources for robustness.
  $values = [];

  // Method 1: Read the inner select's #value directly.
  // By the time #after_build fires, doBuildForm() has already processed the
  // inner 'select' child and set its #value from POST data.
  if (isset($element['select']['#value'])) {
    $v = $element['select']['#value'];
    if (!empty($v) && is_string($v)) {
      $values[] = $v;
    }
    elseif (is_array($v)) {
      $values = array_merge($values, array_filter($v));
    }
  }

  // Method 2: Read the parent widget's #value (set by valueCallback).
  if (empty($values) && !empty($element['#value'])) {
    $vals = is_array($element['#value']) ? $element['#value'] : [$element['#value']];
    $values = array_merge($values, array_filter($vals, 'is_string'));
  }

  // Method 3: Fall back to parsing user input via #parents.
  if (empty($values)) {
    $v = NestedArray::getValue($input, $select_parents);
    if (!empty($v) && is_string($v)) {
      $values[] = $v;
    }
  }

  // Restrict the selectable options to the CURRENT job's service addresses.
  // field_party_to_serve_addresses is a list_string whose global storage
  // allowed_values accumulates EVERY job's addresses (only needed so saved
  // values pass validation), so the widget would otherwise list addresses from
  // other jobs. The current job's address list is stashed on the element in
  // hook_field_widget_single_element_form_alter (#aps_job_addresses).
  $job_addresses = $element['#aps_job_addresses'] ?? NULL;
  if (is_array($job_addresses)) {
    // The widget is either a select_or_other (inner 'select' child) or a plain
    // options select (#options on the widget element itself).
    $opts_key = isset($element['select']['#options']) ? 'select' : NULL;
    $existing = $opts_key ? $element['select']['#options'] : ($element['#options'] ?? []);
    // Order: "- None -" first, addresses, then "- Other -" LAST so the dropdown
    // does not default to "- Other -" on a new paragraph.
    $restricted = [];
    if (isset($existing['_none'])) {
      $restricted['_none'] = $existing['_none'];
    }
    $restricted += $job_addresses;
    if (isset($existing['select_or_other'])) {
      $restricted['select_or_other'] = $existing['select_or_other'];
    }
    // Keep any currently-submitted value so it still validates / displays
    // (e.g. a custom "Other" address, or a value saved earlier).
    foreach ($values as $value) {
      if ($value !== '' && $value !== '_none' && $value !== 'select_or_other' && !isset($restricted[$value])) {
        $restricted[$value] = $value;
      }
    }
    if ($opts_key) {
      $element['select']['#options'] = $restricted;
    }
    $element['#options'] = $restricted;
  }

  foreach ($values as $value) {
    if ($value === '' || $value === '_none' || $value === 'select_or_other') {
      continue;
    }
    // Add to parent widget's #options so Drupal's form validation accepts it.
    if (isset($element['#options']) && !isset($element['#options'][$value])) {
      $element['#options'][$value] = $value;
    }
    // Add to inner select's #options so performRequiredValidation() passes.
    if (isset($element['select']['#options']) && !isset($element['select']['#options'][$value])) {
      $element['select']['#options'][$value] = $value;
    }
    // Add to field storage allowed_values so entity-level validation passes.
    _associatedps_forms_ensure_party_address_allowed($value);
  }

  return $element;
}

/**
 * Ensures a dynamically-set address value exists in field storage
 * allowed_values for paragraph.field_party_to_serve_addresses.
 *
 * This covers entity-level validation (AllowedValuesConstraint) which checks
 * the field storage config independently of the form element's #options.
 */
function _associatedps_forms_ensure_party_address_allowed($value) {
  // Use a static cache to avoid redundant config loads/saves per request.
  static $checked = [];
  if (isset($checked[$value])) {
    return;
  }
  $checked[$value] = TRUE;

  $storage = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->load('paragraph.field_party_to_serve_addresses');
  if (!$storage) {
    return;
  }

  // getSetting() returns the simplified flat format: [value => label, ...].
  $allowed_values = $storage->getSetting('allowed_values');

  if (isset($allowed_values[$value])) {
    return;
  }

  $allowed_values[$value] = $value;
  $storage->setSetting('allowed_values', $allowed_values)->save();
  drupal_static_reset('options_allowed_values');
}

/**
 * After-build callback for standard select widgets (e.g. field_person_delivered_to).
 *
 * Reads the submitted value from user input and adds it to #options so
 * Drupal's form-level select validation accepts values set by JavaScript.
 */
function _associatedps_forms_after_build_standard_select($element, FormStateInterface $form_state) {
  $input = $form_state->getUserInput();
  $field_name = $element['#parents'][0] ?? '';
  $value = $input[$field_name] ?? '';
  if (!empty($value) && $value !== '_none') {
    if (isset($element['#options']) && !isset($element['#options'][$value])) {
      $element['#options'][$value] = $value;
    }
  }
  return $element;
}

/**
 * Validate callback: ensure dynamically-set select values exist in field
 * storage allowed_values before entity validation runs.
 *
 * Handles:
 * - field_person_delivered_to (node-level field)
 * - field_party_to_serve_addresses (paragraph-level, nested inside IEF)
 */
function _associatedps_forms_validate_dynamic_select_options(&$form, FormStateInterface $form_state) {
  $input = $form_state->getUserInput();

  // --- field_person_delivered_to + its Attendance Note copy (node-level) ---
  // Both are list_string options_select fields whose options are populated
  // dynamically from party names, so a chosen value may not exist in field
  // storage allowed_values yet.
  //
  // These two fields mirror each other: the service-details entity builder
  // copies EITHER field's value into the OTHER on save. The options_select
  // widget DROPS a stored value that is not in its storage allowed_values when
  // it computes #default_value (during widget build, before form_alter can
  // extend #options) — so a synced value would persist to the DB yet render
  // BLANK on the other tab. To avoid that (and to let entity validation accept
  // either value), register EVERY submitted person value on BOTH fields'
  // storage allowed_values, not just on the field it was typed in.
  $person_fields = ['field_person_delivered_to', 'field_atten_person_delivered_to'];
  $person_values = [];
  foreach ($person_fields as $pf) {
    $v = $input[$pf] ?? '';
    // '_other' is the literal trigger marker, not a real value — skip it (the
    // typed value is appended as its own option client-side).
    if (!empty($v) && $v !== '_none' && $v !== '_other') {
      $person_values[$v] = $v;
    }
  }
  if (!empty($person_values)) {
    $reset = FALSE;
    foreach ($person_fields as $pf) {
      $storage = \Drupal::entityTypeManager()
        ->getStorage('field_storage_config')
        ->load('node.' . $pf);
      if (!$storage) {
        continue;
      }
      // getSetting() returns the simplified flat format: [value => label, ...].
      $allowed_values = $storage->getSetting('allowed_values');
      $changed = FALSE;
      foreach ($person_values as $v) {
        if (!isset($allowed_values[$v])) {
          $allowed_values[$v] = $v;
          $changed = TRUE;
        }
      }
      if ($changed) {
        $storage->setSetting('allowed_values', $allowed_values)->save();
        $reset = TRUE;
      }
    }
    if ($reset) {
      drupal_static_reset('options_allowed_values');
    }
  }

  // --- field_party_to_serve_addresses (paragraph-level, inside IEF) ---
  // Traverse the nested IEF input to find any dynamically-set address values.
  foreach (['field_attendance_notes', 'field_para_address'] as $ief_field) {
    if (!isset($input[$ief_field]['form']) || !is_array($input[$ief_field]['form'])) {
      continue;
    }
    foreach ($input[$ief_field]['form'] as $delta => $subform_input) {
      if (!is_array($subform_input)) {
        continue;
      }
      $addr_value = $subform_input['field_party_to_serve_addresses']['select'] ?? '';
      if (!empty($addr_value) && $addr_value !== '_none' && $addr_value !== 'select_or_other') {
        _associatedps_forms_ensure_party_address_allowed($addr_value);
      }
    }
  }
}

/**
 * Get all user list for allocated_to/served_by/employee fields.
 */
function _associatedps_forms_get_users(array $uids) {
  $options['_none'] = '- None -';
  foreach ($uids as $uid) {
    $user = User::load($uid);
    $address = $user->field_address->getValue();
    $address = reset($address);
    if($address && isset($address['given_name']) && isset($address['family_name']))
      $full_name = $address['given_name'] . ' ' . $address['family_name'];
    else
      $full_name = NULL;
    $options[$uid] = $full_name;
  }
  return $options;
}

/**
 * Implements hook_entity_insert().
 */
function associatedps_forms_node_insert(NodeInterface $node) {
  if ($node->getType() === 'online_instruction') {
    $nid = $node->id();
    \Drupal::logger('associatedps_forms')->notice('Online Instruction node created with NID: @nid', ['@nid' => $nid]);
    EmailTemplateController::createEmailTemplate($nid, 'true');
  }

  // A job created already carrying an instruction-received date counts as
  // "empty -> valid date", so send the Instructions Received email.
  if ($node->getType() === 'job' && !empty($node->get('field_instruction_received')->value)) {
    _associatedps_forms_send_instructions_received_email($node);
  }
}

/**
 * Implements hook_entity_update().
 */
function associatedps_forms_node_update(NodeInterface $node) {
  if ($node->getType() === 'online_instruction') {
    $nid = $node->id();
    \Drupal::logger('associatedps_forms')->notice('Online Instruction node updated with NID: @nid', ['@nid' => $nid]);
    EmailTemplateController::createEmailTemplate($nid);
  }

  if ($node->getType() === 'job') {
    \drupal::logger('associatedps_forms')->notice('Job node updated with NID: @nid', ['@nid' => $node->id()]);
    /* Send email on change Case Status. */
    /*get client details*/
    $nid = $node->id();
    $job_node = Node::load($nid);
    $client_items = $job_node->get('field_client')[0]->entity ?? NULL;
    //check if any update-email event is enabled for client.
    if($client_items &&
      $client_items->get('field_instructions_received')->value != 1 &&
      $client_items->get('field_attendance_update_frequenc')->value != 1 &&
      $client_items->get('field_served')->value != 1 &&
      $client_items->get('field_attempted')->value != 1 &&
      $client_items->get('field_completed')->value != 1){
      Drupal::logger('associatedps_forms')->notice('All update-email events are disabled for client: @client. So, email will not be sent.', ['@client' => $client_items->id()]);
      return;
    }

    // Send the Instructions Received email when the instruction date is set
    // for the first time (empty -> valid date).
    $instr_new = $node->get('field_instruction_received')->value;
    $instr_old = isset($node->original) ? $node->original->get('field_instruction_received')->value : NULL;
    if (!empty($instr_new) && empty($instr_old)) {
      _associatedps_forms_send_instructions_received_email($node);
    }

    $case_status = $node->field_case_status->value;
    $case_status_value = $node->field_case_status_value->value;
    \Drupal::logger('associatedps_forms')->notice('Job @nid case status: @cs (last sent: @csv)', ['@nid' => $nid, '@cs' => $case_status, '@csv' => $case_status_value]);

    // Only act when the Case Status actually changed (avoid re-sending).
    if (!empty($case_status) && $case_status !== 'Ongoing' && $case_status !== $case_status_value) {
      // Normalise for matching (en-dash -> hyphen, lower-case, trim).
      $status_key = strtolower(trim(str_replace('–', '-', $case_status)));

      // Job update events: Case Status => [client opt-in checkbox, email template title].
      // The template is a Library node (category "Email") whose title matches.
      $status_map = [
        'completed - served'    => ['field_served', 'Served'],
        'completed - attempted' => ['field_attempted', 'Attempted'],
        'completed - enquiries'  => ['field_completed', 'Completed'],
      ];

      if (isset($status_map[$status_key])) {
        [$checkbox_field, $template_title] = $status_map[$status_key];
        // Send only if the client opted in to this event.
        if ($client_items && $client_items->get($checkbox_field)->value == 1) {
          $tpl = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
            'type' => 'library',
            'field_category' => 'Email',
            'title' => $template_title,
          ]);
          if (!empty($tpl)) {
            EmailTemplateController::createEmailTemplate(array_key_first($tpl), $nid, 'job');
          }
          else {
            \Drupal::messenger()->addWarning(t('No email template found with category "Email" and title "@title". Email was not sent.', ['@title' => $template_title]));
            \Drupal::logger('associatedps_forms')->notice('No "@title" email template found for job @nid.', ['@title' => $template_title, '@nid' => $nid]);
          }
        }
        else {
          \Drupal::logger('associatedps_forms')->notice('Client opted out of "@field" for job @nid. Email not sent.', ['@field' => $checkbox_field, '@nid' => $nid]);
        }
      }
      // Legacy "Logged" status uses its own template.
      elseif ($status_key === 'logged') {
        $email_template_logged = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'library', 'field_category' => 'Email', 'title' => 'Logged']);
        if (!empty($email_template_logged)) {
          EmailTemplateController::createEmailTemplate(array_key_first($email_template_logged), $nid, 'job');
        }
        else {
          \Drupal::messenger()->addWarning(t('No email template found with category "Email" and title "Logged". Email was not sent.'));
        }
      }
    }
  }

}

/**
 * Send the "Instructions Received" client email for a job.
 *
 * Fires when a job's instruction-received date is first set. Sends only if the
 * linked client opted in (field_instructions_received) and an "Instructions
 * Received" Library/Email template exists. Reuses the 'job' send path.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The job node being saved.
 */
function _associatedps_forms_send_instructions_received_email(NodeInterface $node) {
  $client = $node->get('field_client')[0]->entity ?? NULL;
  if (!$client) {
    return;
  }
  // Client must have opted in to the Instructions Received update email.
  if ($client->get('field_instructions_received')->value != 1) {
    \Drupal::logger('associatedps_forms')->notice('Client @cid opted out of Instructions Received for job @nid. Email not sent.', ['@cid' => $client->id(), '@nid' => $node->id()]);
    return;
  }
  // Load the Library/Email template titled "Instructions Received".
  $tpl = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
    'type' => 'library',
    'field_category' => 'Email',
    'title' => 'Instructions Received',
  ]);
  if (empty($tpl)) {
    \Drupal::messenger()->addWarning(t('No email template found with category "Email" and title "Instructions Received". Email was not sent.'));
    \Drupal::logger('associatedps_forms')->notice('No "Instructions Received" template found for job @nid.', ['@nid' => $node->id()]);
    return;
  }
  EmailTemplateController::createEmailTemplate(array_key_first($tpl), $node->id(), 'job');
}
