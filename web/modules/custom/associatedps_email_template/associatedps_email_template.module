<?php

/**
 * @file
 * This is the module to send mail.
 */

use Drupal\node\Entity\Node;
use Drupal\Core\Database\Database;
use Drupal\associatedps_email_template\Controller\EmailTemplateController;

/**
 * Implements hook_mail().
 */
function associatedps_email_template_mail($key, &$message, $params) {
  $options = ['langcode' => $message['langcode']];

  switch ($key) {
    case 'SEND_EMAIL_TO_CLIENT':
      $message['From'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('@title', ['@title' => $params['subject']], $options);
      $message['body'][] = check_markup(($params['message']), 'full_html');
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8;';
      break;

    case 'SEND_EMAIL_TO_ADMIN':
      $message['From'] = $params['from'];
      $message['subject'] = t('@title', ['@title' => $params['subject']], $options);
      $message['body'][] = check_markup(($params['message']), 'full_html');
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8;';
      break;
  }
}

/**
 * Implements hook_cron().
 *
 * Sends the recurring "Attendance Update" client email. For every client opted
 * in via the "Attendance Update - Frequency" checkbox
 * (field_attendance_update_frequenc), each of that client's jobs whose
 * instruction-received date is set gets an update email every
 * field_email_interval days (any case status). The email body's [attendance]
 * token is replaced with the job's Attendance Note details.
 *
 * Scheduling: Drupal's automated cron has no clock of its own, so this is
 * guarded to run at most once per day and only after 05:00 server time (it
 * fires on the first cron run past 5am). The day-count is anchored on
 * field_last_mail_time, or the instruction-received date when no mail has been
 * sent yet (so the first update fires `interval` days after instructions), and
 * field_last_mail_time is re-stamped on each send by EmailTemplateController
 * (content type 'cron').
 */
function associatedps_email_template_cron() {
  // Run once per day, only after 05:00 (server time).
  if ((int) date('G') < 5) {
    return;
  }
  $today = date('Y-m-d');
  $state = \Drupal::state();
  if ($state->get('associatedps_email_template.attendance_cron_last_run') === $today) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');

  // Load the "Attendance Update" Email template once (Library node).
  $tpl = $storage->loadByProperties([
    'type' => 'library',
    'field_category' => 'Email',
    'title' => 'Attendance Update',
  ]);
  if (empty($tpl)) {
    \Drupal::logger('associatedps_email_template')->warning('Cron: no Email Library template titled "Attendance Update"; recurring client updates skipped.');
    return;
  }
  $template_nid = array_key_first($tpl);

  $client_nids = \Drupal::entityQuery('node')
    ->condition('type', 'client')
    ->accessCheck(FALSE)
    ->execute();
  if (empty($client_nids)) {
    $state->set('associatedps_email_template.attendance_cron_last_run', $today);
    return;
  }

  $today_date = date_create($today);
  $db = Database::getConnection();

  foreach (Node::loadMultiple($client_nids) as $client) {
    // Opt-in: the "Attendance Update - Frequency" checkbox gates the send.
    if ((int) $client->get('field_attendance_update_frequenc')->value !== 1) {
      continue;
    }
    // Frequency in days. No/zero interval means no schedule.
    $interval = (int) $client->get('field_email_interval')->value;
    if ($interval <= 0) {
      continue;
    }
    $client_nid = $client->id();

    // All jobs that reference this client.
    $job_ids = $db->select('node__field_client', 'fc')
      ->fields('fc', ['entity_id'])
      ->condition('fc.field_client_target_id', $client_nid)
      ->execute()
      ->fetchCol();

    foreach ($job_ids as $job_id) {
      $job = Node::load($job_id);
      if (!$job) {
        continue;
      }
      // Requires an instruction-received date (sends for any case status).
      if (empty($job->get('field_instruction_received')->value)) {
        continue;
      }

      // Anchor on the last update sent, else the instruction-received date so
      // the first update fires `interval` days after instructions.
      $last_mail = $job->get('field_last_mail_time')->value;
      $anchor_ts = !empty($last_mail)
        ? $job->get('field_last_mail_time')->date->getTimestamp()
        : $job->get('field_instruction_received')->date->getTimestamp();
      $anchor = date_create(date('Y-m-d', $anchor_ts));

      // >= (not ==): a single missed cron run must not skip the send forever.
      $days = (int) date_diff($anchor, $today_date)->format('%a');
      if ($days >= $interval) {
        // 'cron' => use the title-loaded template + stamp field_last_mail_time.
        EmailTemplateController::createEmailTemplate($template_nid, $job_id, 'cron');
      }
    }
  }

  $state->set('associatedps_email_template.attendance_cron_last_run', $today);
}
