<?php

use Drupal\associatedps_affidavit_template\Form\TemplateUploadForm;
use Drupal\node\NodeInterface;
use Drupal\Core\Entity\EntityFieldManagerInterface;
use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * @file
 * Contains associatedps_affidavit_template.module.
 */

function form_handler(&$form){
  $form['#attached']['library'][] = 'associatedps_affidavit_template/template-handler';
  // return;
  // $entity_fields = get_Entity_Fields();

  // asort($entity_fields['options']);

  // Render a small UI in the same details section, *below* your upload_form.
  // $form['field_short_codes']['widget']['#options'] = $entity_fields['options'];
  // array_unshift($form['field_short_codes']['widget']['#options'], "--None--");

  // Expose settings to JS. We’ll target the CKEditor inside #template-editor-wrapper.
  $form['#attached']['drupalSettings']['associatedpsShortcodes'] = [
      // 'shortcodeMap' => $entity_fields['map'],
      // This is the wrapper you already set on your subform’s editor container.
      'targetContainerSelector' => '.form-textarea-wrapper',
  ];
}

function get_Entity_Fields(){
  /*Logic to work with shortcodes*/
  /** @var \Drupal\Core\Entity\EntityFieldManagerInterface $field_manager */
  $field_manager = \Drupal::service('entity_field.manager');

  $bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');

  $node_fields = [];

  foreach ($bundles as $bundle => $info) {
      // Get all field definitions for this bundle (content type).
      $fields = $field_manager->getFieldDefinitions('node', $bundle);
      $node_fields[$bundle] = $fields;
  }

  $options = [];
  $map = [];

  foreach ($node_fields as $bundle => $fields) {
      foreach ($fields as $field_name => $definition) {
      // Skip base fields unless you want to include some (e.g. title).
      if ($definition->getFieldStorageDefinition()->isBaseField()) {
          // if ($field_name !== 'title') { continue; }
          continue;
      }
      $label = $definition->getLabel();
      $options[$field_name] = strtoupper($bundle). '-' . $label . ' (' . $field_name . ')';
      $map[$field_name] = '[' . $field_name . ']';

      }
  }
  return [ 'options'=>$options, 'map'=>$map ];
}

function associatedps_affidavit_template_form_node_template_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  \Drupal::logger('associatedps_affidavit_template')->notice("Reached associatedps_affidavit_template_form_node_template_edit_form_alter - $form_id");
  form_handler($form);
}

function associatedps_affidavit_template_form_node_template_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  \Drupal::logger('associatedps_affidavit_template')->notice("Reached associatedps_affidavit_template_form_node_template_form_alter - $form_id");
  form_handler($form);
}

/**
 * Implements hook_form_FORM_ID_alter() for node_library_form.
 */
function associatedps_affidavit_template_form_node_library_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  _associatedps_affidavit_template_library_form_alter($form, $form_state);
  _associatedps_affidavit_template_library_first_step($form, $form_state);
}

/**
 * Reduce the Library ADD form to Title plus a Next button.
 *
 * A template cannot be uploaded to Microsoft 365 usefully until the node it
 * belongs to exists: the SharePoint file is tracked against a node id, and
 * without one there is nothing to write the edited document back onto. The old
 * behaviour let the author upload first and only told them afterwards that the
 * document could not come back — the worst possible moment, since by then they
 * may already have edited it.
 *
 * So creation is split. Step one captures the title and saves, which mints the
 * node id. Step two is the ordinary edit form, where category and file upload
 * appear and every id needed for the round trip already exists.
 *
 * Only `title` is required on this bundle, so hiding the rest cannot block the
 * save. The EDIT form is deliberately untouched.
 */
function _associatedps_affidavit_template_library_first_step(array &$form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject()->getEntity();
  if (!$entity || !$entity->isNew()) {
    return;
  }

  // Everything except the title and the buttons. Drupal's own internals
  // (form_build_id, form_token, form_id) must survive or the form will not
  // submit at all.
  foreach (array_keys($form) as $key) {
    if (strpos($key, '#') === 0 || strpos($key, 'form_') === 0) {
      continue;
    }
    if ($key === 'title' || $key === 'actions') {
      continue;
    }
    $form[$key]['#access'] = FALSE;
  }

  $form['aps_first_step_help'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#value' => t('Give this template a title first. The category and the Word document come next, once the item exists.'),
    '#weight' => -100,
  ];

  if (isset($form['actions']['submit'])) {
    // Labelled Next because it reads as step one of two; it is still an
    // ordinary save, and the node really is created here.
    $form['actions']['submit']['#value'] = t('Next');
    $form['actions']['submit']['#submit'][] = '_associatedps_affidavit_template_library_first_step_submit';
  }
  // Previewing half a form helps nobody.
  if (isset($form['actions']['preview'])) {
    $form['actions']['preview']['#access'] = FALSE;
  }
}

/**
 * Send the author straight to the edit form after step one.
 *
 * Appended after ::save, so the node id exists by the time this runs.
 */
function _associatedps_affidavit_template_library_first_step_submit(array $form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node || $node->isNew()) {
    return;
  }

  \Drupal::messenger()->addStatus(t('Now choose the category and upload the Word document.'));
  $form_state->setRedirect('entity.node.edit_form', ['node' => $node->id()]);
}

/**
 * Implements hook_form_FORM_ID_alter() for node_library_edit_form.
 */
function associatedps_affidavit_template_form_node_library_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  _associatedps_affidavit_template_library_form_alter($form, $form_state);
}

/**
 * Shared form alter for Library add/edit forms (PandaDoc integration).
 */
function _associatedps_affidavit_template_library_form_alter(array &$form, FormStateInterface $form_state) {
  // Hide fields not relevant to Library.
  if (isset($form['field_case_status'])) {
    $form['field_case_status']['#access'] = FALSE;
  }
  if (isset($form['field_job_types'])) {
    $form['field_job_types']['#access'] = FALSE;
  }

  // Category-based field visibility via #states.
  // Email → show email_subject + body, hide import/tokens/pandadoc_template_id.
  // Affidavit/Correspondence → show import/tokens/pandadoc_template_id, hide email fields.
  if (isset($form['field_email_subject'])) {
    $form['field_email_subject']['#states'] = [
      'visible' => [
        ':input[name="field_category"]' => ['value' => 'Email'],
      ],
    ];
  }
  if (isset($form['body'])) {
    $form['body']['#states'] = [
      'visible' => [
        ':input[name="field_category"]' => ['value' => 'Email'],
      ],
    ];
  }
  if (isset($form['field_import_template'])) {
    $form['field_import_template']['#states'] = [
      'visible' => [
        [':input[name="field_category"]' => ['value' => 'Affidavit']],
        [':input[name="field_category"]' => ['value' => 'Correspondence']],
        // Invoice templates are authored the same way (.docx → Word for the
        // web) and merged from the Job's invoice-document download icon.
        [':input[name="field_category"]' => ['value' => 'Invoice']],
      ],
    ];
  }
  if (isset($form['field_available_tokens'])) {
    // Replace the hand-maintained token textarea with an auto-generated,
    // searchable Chosen picker built from the LIVE Job form display. Selecting a
    // token copies its [node:...] value to the clipboard to paste into the body.
    // The email resolver now reads tokens straight out of the body (body-scan in
    // _associatedps_pdf_templates_library_data), so this textarea is no longer
    // needed as the substitution list. It is HIDDEN, not removed, so any legacy
    // stored value stays on the node and existing templates are untouched.
    $form['field_available_tokens']['#access'] = FALSE;

    $token_options = (new \Drupal\associatedps_affidavit_template\Service\EmailTemplateTokenMapper())
      ->getEmailTokenOptions();

    $form['available_tokens_picker'] = [
      '#type' => 'select',
      '#title' => t('Job Available Tokens'),
      '#description' => t('Search and select a field — its token is copied to your clipboard. Paste it into the email body where you want the value to appear.'),
      // Option value = the [node:...] token that gets copied; option label = the
      // readable "<Tab>-<Section>-...-<Field>" path (same labels as the DocuSign
      // token picker). Form-only helper — never submitted or saved.
      '#options' => ['' => t('- Select a token to copy -')] + $token_options,
      '#chosen' => TRUE,
      '#default_value' => '',
      '#weight' => $form['field_available_tokens']['#weight'] ?? 10,
      // js-aps-token-picker is the shared hook the copy-on-select behavior binds
      // to (both this Job picker and the Online Instruction picker below).
      '#attributes' => ['id' => 'aps-email-token-picker', 'class' => ['js-aps-token-picker']],
      '#states' => [
        'visible' => [
          ':input[name="field_category"]' => ['value' => 'Email'],
        ],
      ],
    ];
    $form['#attached']['library'][] = 'associatedps_affidavit_template/email-token-picker';
  }
  // Online Instruction token list — the [node:*] tokens for the
  // online_instruction bundle (used when this template drives the Online
  // Instruction admin email). Same treatment as field_available_tokens: hide
  // the hand-maintained textarea and offer a Chosen copy picker instead. The
  // online_instruction form has no tabs (only fieldsets), so the mapper builds
  // its labels with includeUntabbed = TRUE. The resolver body-scans this
  // template's body for [node:*] tokens too (see
  // _associatedps_pdf_templates_library_data), so the textarea is only hidden.
  if (isset($form['field_instruction_tokens'])) {
    $form['field_instruction_tokens']['#access'] = FALSE;

    $instruction_options = (new \Drupal\associatedps_affidavit_template\Service\EmailTemplateTokenMapper())
      ->getInstructionTokenOptions();

    $form['instruction_tokens_picker'] = [
      '#type' => 'select',
      '#title' => t('Online Instruction Available tokens'),
      '#description' => t('Search and select an Online Instruction field — its token is copied to your clipboard. Paste it into the email body where you want the value to appear.'),
      '#options' => ['' => t('- Select a token to copy -')] + $instruction_options,
      '#chosen' => TRUE,
      '#default_value' => '',
      '#weight' => $form['field_instruction_tokens']['#weight'] ?? 11,
      '#attributes' => ['id' => 'aps-instruction-token-picker', 'class' => ['js-aps-token-picker']],
      '#states' => [
        'visible' => [
          ':input[name="field_category"]' => ['value' => 'Email'],
        ],
      ],
    ];
    $form['#attached']['library'][] = 'associatedps_affidavit_template/email-token-picker';
  }
  // PandaDoc kill-switch: when active, only PandaDoc logic runs; when
  // inactive (default), only DocuSign logic runs. The two integrations
  // never run side by side.
  $pandadoc_active = _associatedps_affidavit_template_pandadoc_active();

  // Field visibility states + readonly attribute (Affidavit/Correspondence/
  // Invoice — the .docx document categories).
  $template_field_states = [
    'visible' => [
      [':input[name="field_category"]' => ['value' => 'Affidavit']],
      [':input[name="field_category"]' => ['value' => 'Correspondence']],
      [':input[name="field_category"]' => ['value' => 'Invoice']],
    ],
  ];
  if ($pandadoc_active) {
    if (isset($form['field_pandadoc_template_id'])) {
      $form['field_pandadoc_template_id']['#states'] = $template_field_states;
      $form['field_pandadoc_template_id']['widget'][0]['value']['#attributes']['readonly'] = 'readonly';
    }
  }
  else {
    // Hide the two DocuSign template ID fields.
    //
    // They serve no purpose now: templates are authored in Word for the web,
    // and generation reads the .docx file attached to the Library item, not a
    // DocuSign template ID. Nothing writes these fields and nothing reads them.
    //
    // #access = FALSE hides them from the form in code. Taking them out of the
    // form display instead would be a config change, which then has to be
    // exported and imported on every environment. The fields themselves and any
    // values already saved in them are left alone; they are removed when the
    // DocuSign fields are deleted.
    foreach (['field_docusign_template_id', 'field_docgen_template_id'] as $template_id_field) {
      if (isset($form[$template_id_field])) {
        $form[$template_id_field]['#access'] = FALSE;
      }
    }
  }

  // Query-param population on return from the editor.
  $request = \Drupal::request();
  if ($pandadoc_active) {
    $pandadoc_template_id = $request->query->get('pandadoc_template_id');
    if ($pandadoc_template_id && isset($form['field_pandadoc_template_id'])) {
      $form['field_pandadoc_template_id']['widget'][0]['value']['#default_value'] = $pandadoc_template_id;
    }
  }
  else {
    // Which param came back tells us which editor the user just returned from.
    $docusign_template_id = $request->query->get('docusign_template_id');
    if ($docusign_template_id && isset($form['field_docusign_template_id'])) {
      $form['field_docusign_template_id']['widget'][0]['value']['#default_value'] = $docusign_template_id;
    }
    $docgen_template_id = $request->query->get('docgen_template_id');
    if ($docgen_template_id && isset($form['field_docgen_template_id'])) {
      $form['field_docgen_template_id']['widget'][0]['value']['#default_value'] = $docgen_template_id;
    }
  }
  $category_param = $request->query->get('category');
  if ($category_param && isset($form['field_category'])) {
    $form['field_category']['widget']['#default_value'] = $category_param;
  }

  // Read existing template ID from the active integration's field.
  $node = $form_state->getFormObject()->getEntity();
  $nid = $node->id() ?: 0;
  $existingTemplateId = '';
  $existingDocGenTemplateId = '';
  if ($pandadoc_active) {
    if ($node->hasField('field_pandadoc_template_id')) {
      $existingTemplateId = $node->get('field_pandadoc_template_id')->value ?: '';
    }
  }
  else {
    if ($node->hasField('field_docusign_template_id')) {
      $existingTemplateId = $node->get('field_docusign_template_id')->value ?: '';
    }
    if ($node->hasField('field_docgen_template_id')) {
      $existingDocGenTemplateId = $node->get('field_docgen_template_id')->value ?: '';
    }
  }

  // "Update at …" button + drupalSettings + library attach — only the
  // active integration renders.
  if ($pandadoc_active) {
    if (!empty($existingTemplateId)) {
      $form['pandadoc_update_btn'] = [
        '#type' => 'container',
        '#weight' => 99,
        '#states' => $template_field_states,
        'button' => [
          '#type' => 'html_tag',
          '#tag' => 'button',
          '#value' => 'Update at PandaDoc',
          '#attributes' => [
            'type' => 'button',
            'id' => 'pandadoc-update-btn',
            'class' => ['button', 'button--primary'],
            'data-template-id' => $existingTemplateId,
            'data-nid' => $nid,
            'style' => 'margin-top:10px;',
          ],
        ],
      ];
    }

    $form['#attached']['drupalSettings']['pandadocLibrary'] = [
      'ajaxUploadUrl' => '/admin/content/pandadoc/ajax-upload',
      'ajaxSessionUrl' => '/admin/content/pandadoc/ajax-session',
      'editorPageBaseUrl' => '/admin/content/pandadoc/editor',
      'existingTemplateId' => $existingTemplateId,
      'nid' => $nid,
    ];
    $form['#attached']['library'][] = 'associatedps_affidavit_template/pandadoc-library-form';
  }
  else {
    // The two "Update at DocuSign" buttons used to be built here, one for a tab
    // template and one for a Document Generation template. Both are removed:
    // there is nothing at DocuSign to update any more. A template that already
    // holds a .docx is re-edited with the "Update document" button below.

    // "Edit in Word" for a template that already has a document — the
    // equivalent of "Update at DocuSign", but without a stored id. DocuSign has
    // to remember a template id because the authoritative copy lives at
    // DocuSign; here the authoritative copy is field_import_template on this
    // node and SharePoint is only ever a temporary workspace, so re-editing is
    // just "push the current server file up again".
    $m365_existing_file = '';
    $library_node = $form_state->getFormObject()->getEntity();
    if ($library_node && !$library_node->isNew() && $library_node->hasField('field_import_template')) {
      $existing = $library_node->get('field_import_template')->getValue();
      if (!empty($existing[0]['target_id'])) {
        $existing_file = \Drupal::entityTypeManager()->getStorage('file')->load($existing[0]['target_id']);
        // Only .docx — Word for the web cannot edit a PDF or a .doc.
        if ($existing_file && preg_match('/\.docx$/i', $existing_file->getFilename())) {
          $m365_existing_file = $existing_file->getFilename();
        }
      }
    }

    // Token panel for authoring. Sits immediately above the form actions, so it
    // is in reach while the author works in the other tab — the tokens are what
    // they are copying INTO the Word document, so it has to stay on screen for
    // the whole editing session rather than living on a separate page.
    //
    // Only for document categories: the Email category already has its own
    // picker from the email-token-picker library, and two pickers on one form
    // would be worse than none.
    $form['m365_token_panel'] = [
      '#type' => 'container',
      '#weight' => 100,
      '#states' => $template_field_states,
      '#attributes' => ['id' => 'm365-token-panel'],
    ];
    // Invoice category only: a second panel with the Invoice tokens, whose
    // values are read from Xero when the invoice document is generated
    // (InvoiceDocumentController). Separate from the Job panel so Affidavit and
    // Correspondence authors are never offered tokens that would merge empty.
    $form['m365_invoice_token_panel'] = [
      '#type' => 'container',
      '#weight' => 100.5,
      '#states' => [
        'visible' => [
          ':input[name="field_category"]' => ['value' => 'Invoice'],
        ],
      ],
      '#attributes' => ['id' => 'm365-invoice-token-panel'],
    ];
    // Push the buttons below it. Without this the panel can land under Save,
    // which is exactly where nobody looks for it.
    $form['actions']['#weight'] = 101;

    if ($m365_existing_file !== '') {
      $form['m365_update_btn'] = [
        '#type' => 'container',
        '#weight' => 99,
        '#states' => $template_field_states,
        'button' => [
          '#type' => 'html_tag',
          '#tag' => 'button',
          // Fixed label, deliberately: the filename was in here and its length
          // dictated the button's width, which made the button impossible to
          // style consistently. The filename is shown in the panel instead.
          '#value' => 'Update document',
          '#attributes' => [
            'type' => 'button',
            'id' => 'm365-update-btn',
            'class' => ['button'],
            'data-nid' => $nid,
            'style' => 'margin-top:10px;',
          ],
        ],
      ];
    }

    /** @var \Drupal\associatedps_affidavit_template\Service\DocuSignDocGenClient $docgen_client */
    $docgen_client = \Drupal::service('associatedps_affidavit_template.docusign_docgen_client');
    $docgen_configured = $docgen_client->isConfigured();

    $form['#attached']['drupalSettings']['docusignLibrary'] = [
      'ajaxUploadUrl' => '/admin/content/docusign/ajax-upload',
      'ajaxSessionUrl' => '/admin/content/docusign/ajax-edit-view',
      'editorPageBaseUrl' => '/admin/content/docusign/editor',
      'existingTemplateId' => $existingTemplateId,
      'nid' => $nid,
      // The upload-method popup needs to know whether the Doc Gen sandbox
      // account is usable BEFORE the user picks it — an unconfigured account
      // should grey the option out with the reason, not fail after upload.
      'docgen' => [
        'ajaxUploadUrl' => '/admin/content/docusign-docgen/ajax-upload',
        'ajaxSessionUrl' => '/admin/content/docusign-docgen/ajax-edit-view',
        'editorPageBaseUrl' => '/admin/content/docusign-docgen/editor',
        'existingTemplateId' => $existingDocGenTemplateId,
        'configured' => $docgen_configured,
        'configError' => $docgen_configured ? '' : $docgen_client->getConfigurationError(),
      ],
      // Third option in the same popup: author the .docx in Word for the web
      // and merge tokens ourselves later. Same reasoning as docgen above — the
      // card is greyed with the reason rather than failing after the upload,
      // because the usual cause is a missing Entra grant that only an
      // administrator can fix.
      'm365' => _associatedps_affidavit_template_m365_settings((int) $nid),
      // [{label, value}] — label is the field's Tab-Section-Field path from the
      // Job form display, value is the token the author pastes into the Word
      // document. Same labels as the DocuSign editor page, so the two pickers
      // never drift apart; the Jinja2 variant only changes what is pasted,
      // because these .docx templates are merged by Python docxtpl and DocuSign
      // still needs the bare name. See getJobVariableOptionsJinja().
      'tokens' => \Drupal::service('associatedps_affidavit_template.docusign_token_mapper')
        ->getJobVariableOptionsJinja(),
      // Invoice.* / Invoice_Lines.* tokens for the Invoice-only panel; the
      // same constants feed the merge payload, so they cannot drift.
      'invoiceTokens' => \Drupal\associatedps_affidavit_template\Controller\InvoiceDocumentController::tokenOptions(
        \Drupal::service('associatedps_affidavit_template.docusign_token_mapper')
      ),
    ];
    $form['#attached']['library'][] = 'associatedps_affidavit_template/docusign-library-form';
  }
}

/**
 * Settings for the "Edit in Word (Microsoft 365)" card on the Library form.
 *
 * Deliberately total and non-throwing: this runs while building a node form, so
 * a Microsoft outage, an expired secret or a missing Entra grant must grey the
 * card out with an explanation — never break the Library form itself.
 *
 * The permission check costs at most one token request per hour (the token is
 * cached; after that it is a local JWT decode), because the answer has to be
 * known BEFORE the author picks the option rather than after the upload fails.
 *
 * @return array
 *   Keys: enabled, ajaxUploadUrl, configError.
 */
function _associatedps_affidavit_template_m365_settings(int $nid = 0): array {
  $settings = [
    'enabled' => FALSE,
    'ajaxUploadUrl' => '/admin/content/m365/ajax-upload',
    'reopenBaseUrl' => '/admin/content/m365/reopen',
    'configError' => '',
    // An editing session already in progress for this node, so the Done panel
    // can be rebuilt on page load.
    //
    // WHY: the panel used to live only in the browser, built from the upload
    // response, so anything that reloaded the Library tab took the Done button
    // with it permanently. The longer someone edits in the other tab the
    // likelier that is, because browsers DISCARD idle background tabs to
    // reclaim memory and silently reload them on return; a stray refresh or
    // Back does the same. The document was still safe in SharePoint, but there
    // was no way left to pull it back.
    //
    // The session is already recorded server-side, so that is the reliable
    // source of truth. See M365EditSessionStore::getOpen().
    'openSession' => NULL,
  ];

  try {
    /** @var \Drupal\associatedps_affidavit_template\Service\GraphDriveClient $graph */
    $graph = \Drupal::service('associatedps_affidavit_template.graph_drive');

    if (!$graph->isConfigured()) {
      $settings['configError'] = 'Unavailable — Microsoft 365 credentials are not set on this server.';
      return $settings;
    }

    if (!$graph->hasSitesWritePermission()) {
      $settings['configError'] = 'Unavailable — the Microsoft 365 app registration has not been granted '
        . 'Sites.ReadWrite.All. An administrator must grant it and consent in Entra ID.';
      return $settings;
    }

    $settings['enabled'] = TRUE;
  }
  catch (\Throwable $e) {
    \Drupal::logger('associatedps_affidavit_template')->warning(
      'M365 availability check failed while building the Library form: @msg',
      ['@msg' => $e->getMessage()]
    );
    $settings['configError'] = 'Unavailable — could not reach Microsoft 365 (' . $e->getMessage() . ').';
  }

  // Rebuild data for an editing session that is already open on this node.
  // Deliberately outside the try above: even if the availability probe failed,
  // an already-open session still needs its Done button back.
  if ($nid) {
    try {
      /** @var \Drupal\associatedps_affidavit_template\Service\M365EditSessionStore $sessions */
      $sessions = \Drupal::service('associatedps_affidavit_template.m365_sessions');
      $session = $sessions->getOpen($nid);
      if ($session) {
        $settings['openSession'] = [
          'fileName' => $session['file_name'] ?? '',
          'pullUrl' => '/admin/content/m365/pull/' . $nid,
          'discardUrl' => '/admin/content/m365/discard/' . $nid,
          // Minutes elapsed, so the panel can say how much of the four-hour
          // window is left. Cron abandons an open session after four hours.
          'startedMinutesAgo' => isset($session['created'])
            ? (int) floor((\Drupal::time()->getRequestTime() - (int) $session['created']) / 60)
            : 0,
          'maxEditMinutes' => 240,
        ];
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('associatedps_affidavit_template')->warning(
        'Could not read the open M365 session for node @nid: @msg',
        ['@nid' => $nid, '@msg' => $e->getMessage()]
      );
    }
  }

  return $settings;
}

/**
 * PandaDoc integration kill-switch.
 *
 * Returns FALSE while PandaDoc is set aside in favor of DocuSign. All
 * PandaDoc UI attachments, form gates, and (later) Job-form Generate
 * buttons are suppressed when this returns FALSE. Flip to TRUE to revive
 * PandaDoc — no other code change needed.
 *
 * PandaDoc PHP services, controllers, routes, JS files, and the
 * pandadoc_documents DB table remain untouched either way.
 */
function _associatedps_affidavit_template_pandadoc_active(): bool {
  return FALSE;
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node entities.
 *
 * Auto-syncs any newly created Client node to Xero as a contact, regardless
 * of which form/code path created it (the standard /node/add/client form, the
 * CustomAddClient AJAX dialog used by the Job add/edit pages, REST, or
 * programmatic Node::create()). Wrapped in try/catch so a Xero outage cannot
 * block or roll back the Drupal save.
 */
function associatedps_affidavit_template_node_insert(NodeInterface $node): void {
  if ($node->bundle() !== 'client') {
    return;
  }

  try {
    /** @var \Drupal\associatedps_affidavit_template\Service\XeroClient $xero */
    $xero = \Drupal::service('associatedps_affidavit_template.xero_client');

    // Skip cleanly when Xero hasn't been authorized on this environment yet.
    if (!$xero->isConnected()) {
      \Drupal::logger('associatedps_affidavit_template_Xero')->notice(
        'Skipped Xero auto-sync for new Client @nid: integration not authorized.',
        ['@nid' => $node->id()]
      );
      return;
    }

    _associatedps_affidavit_template_sync_client_to_xero($node, 'insert');
  }
  catch (\Throwable $e) {
    // Belt-and-braces — never let a Xero issue propagate to the node save.
    \Drupal::logger('associatedps_affidavit_template_Xero')->error(
      'Unexpected error during Xero auto-sync for Client @nid: @msg',
      ['@nid' => $node->id(), '@msg' => $e->getMessage()]
    );
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for node entities.
 *
 * Mirrors the insert hook for Client edits — looks up the previously stored
 * Xero ContactID and includes it in the POST so the existing contact is
 * updated rather than duplicated (covers Name changes).
 */
function associatedps_affidavit_template_node_update(NodeInterface $node): void {
  if ($node->bundle() !== 'client') {
    return;
  }
  try {
    /** @var \Drupal\associatedps_affidavit_template\Service\XeroClient $xero */
    $xero = \Drupal::service('associatedps_affidavit_template.xero_client');
    if (!$xero->isConnected()) {
      return;
    }
    _associatedps_affidavit_template_sync_client_to_xero($node, 'update');
  }
  catch (\Throwable $e) {
    \Drupal::logger('associatedps_affidavit_template_Xero')->error(
      'Unexpected error during Xero auto-sync (update) for Client @nid: @msg',
      ['@nid' => $node->id(), '@msg' => $e->getMessage()]
    );
  }
}

/**
 * Shared sync helper for Client insert/update hooks.
 *
 * On success, persists the Xero ContactID for the node so subsequent
 * updates target the same Xero record and so invoice generation can route
 * to the right contact.
 *
 * @param string $trigger
 *   Either 'insert' or 'update', used only for log/messenger phrasing.
 */
function _associatedps_affidavit_template_sync_client_to_xero(NodeInterface $node, string $trigger): void {
  /** @var \Drupal\associatedps_affidavit_template\Service\XeroClient $xero */
  $xero = \Drupal::service('associatedps_affidavit_template.xero_client');
  /** @var \Drupal\associatedps_affidavit_template\Service\XeroContactMapper $mapper */
  $mapper = \Drupal::service('associatedps_affidavit_template.xero_contact_mapper');
  /** @var \Drupal\associatedps_affidavit_template\Service\XeroContactStore $store */
  $store = \Drupal::service('associatedps_affidavit_template.xero_contact_store');

  $stored_id = $store->get((int) $node->id());
  $row = $mapper->mapClientNode($node, $stored_id);
  $response = $xero->createContacts([$row]);

  if (isset($response['error'])) {
    \Drupal::logger('associatedps_affidavit_template_Xero')->error(
      'Xero auto-sync (@trigger) failed for Client @nid (@name): @err',
      ['@trigger' => $trigger, '@nid' => $node->id(), '@name' => $node->label(), '@err' => $response['error']]
    );
    \Drupal::messenger()->addWarning(t(
      'Client saved, but pushing to Xero failed: @err',
      ['@err' => $response['error']]
    ));
    return;
  }

  $xero_row = $response['Contacts'][0] ?? NULL;
  $errors = $xero_row['ValidationErrors'] ?? [];
  if (!empty($errors)) {
    $messages = array_filter(array_map(static fn ($e) => $e['Message'] ?? '', $errors));
    \Drupal::logger('associatedps_affidavit_template_Xero')->warning(
      'Xero rejected Client @nid (@name) on @trigger: @msgs',
      ['@trigger' => $trigger, '@nid' => $node->id(), '@name' => $node->label(), '@msgs' => implode(' | ', $messages)]
    );
    \Drupal::messenger()->addWarning(t(
      'Client saved, but Xero reported: @msgs',
      ['@msgs' => implode(' | ', $messages)]
    ));
    return;
  }

  $contact_id = (string) ($xero_row['ContactID'] ?? '');
  if ($contact_id !== '') {
    $store->set((int) $node->id(), $contact_id);
  }
  \Drupal::logger('associatedps_affidavit_template_Xero')->notice(
    'Auto-synced Client @nid (@name) to Xero ContactID @cid (@trigger).',
    ['@trigger' => $trigger, '@nid' => $node->id(), '@name' => $node->label(), '@cid' => $contact_id]
  );
  \Drupal::messenger()->addStatus(t('Client synced to Xero (ContactID: @cid).', [
    '@cid' => $contact_id ?: t('(unavailable)'),
  ]));
}
/**
 * Implements hook_cron().
 *
 * Removes SharePoint copies that could not be deleted at the time.
 *
 * Two cases, both normal rather than exceptional:
 *
 *  - cleanup_pending: the author pressed Done (or Discard) while Word for the
 *    web still held a lock on the document, so the delete returned HTTP 423
 *    resourceLocked. The document was already safely on our server by then;
 *    only the remote copy lingers. Word releases the lock a few minutes after
 *    the last editor closes, so the retry is delayed rather than immediate.
 *
 *  - open, but hours old: the author closed the tab and never pressed Done.
 *    Nothing is coming back, and leaving a copy of a court document sitting in
 *    SharePoint indefinitely is not acceptable, so it is removed.
 */
function associatedps_affidavit_template_cron() {
  /** @var \Drupal\associatedps_affidavit_template\Service\M365EditSessionStore $sessions */
  $sessions = \Drupal::service('associatedps_affidavit_template.m365_sessions');
  /** @var \Drupal\associatedps_affidavit_template\Service\GraphDriveClient $graph */
  $graph = \Drupal::service('associatedps_affidavit_template.graph_drive');
  $logger = \Drupal::logger('associatedps_affidavit_template');

  if (!$graph->isConfigured()) {
    return;
  }

  $now = \Drupal::time()->getRequestTime();

  // Ten minutes is comfortably past the Word lock, without leaving documents
  // lying around for long.
  foreach ($sessions->getCleanupPending($now - 600) as $row) {
    try {
      $graph->deleteItem($row['drive_id'], $row['item_id']);
      $sessions->markPulled((int) $row['id']);
    }
    catch (\Throwable $e) {
      // Left pending deliberately — the next cron run tries again. A row that
      // keeps failing for days is a real problem and will be visible here.
      $logger->warning('M365 cron: still cannot remove @item (session @id): @msg', [
        '@item' => $row['item_id'],
        '@id' => $row['id'],
        '@msg' => $e->getMessage(),
      ]);
    }
  }

  // Abandoned editing sessions: four hours is far longer than any real editing
  // session, so anything older is certainly forgotten rather than in progress.
  foreach ($sessions->getStale($now - 14400) as $row) {
    try {
      $graph->deleteItem($row['drive_id'], $row['item_id']);
      $sessions->markAbandoned((int) $row['id']);
      $logger->info('M365 cron: removed abandoned SharePoint copy @file (node @nid).', [
        '@file' => $row['file_name'],
        '@nid' => $row['library_nid'],
      ]);
    }
    catch (\Throwable $e) {
      $sessions->markCleanupPending((int) $row['id']);
    }
  }
}
